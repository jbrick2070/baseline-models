": {\"vae_name\": names[\"vae\"]}},\r\n 1023:             \"loadimage\": {\"class\": \"loadimage\", \"inputs\": {\"image\": image_name}},\r\n 1024:             \"latent\": {\"class\": \"latent\",\r\n 1025:                        \"inputs\": {\"width\": int(width), \"height\": int(height),\r\n","exit_code":0,"status":"completed"}}
