      for kind in kinds:\r\n  771:             package = f\"nodes._otr_{kind}_engines\"\r\n  772:             try:\r\n  773:                 registry = importlib.import_module(f\"{package}.registry\")\r\n  774:                 names = tuple(registry.all_engine_names())\r\n  775:                 registered = [registry.get_engine(name) for name in names]\r\n  776:                 if requested.startswith(\"eng_\"):\r\n  777:                     module = importlib.import_module(f\"{package}.{requested}\")\r\n  778:                     engine = _select_concrete_engine(module, registered)\r\n  779:                 else:\r\n  780:                     if requested not in names:\r\n  781:                         raise UnsupportedGraphError(\r\n  782:                             f\"{kind} registry has no public engine {requested!r}\"\r\n  783:                         )\r\n  784:                     engine = registry.get_engine(requested)\r\n  785:                     if not callable(getattr(engine, \"_build_graph\", None)):\r\n  786:                         raise UnsupportedGraphError(\r\n  787:                             f\"{kind}:{requested} exposes no pure _build_graph\"\r\n  788:                         )\r\n  789:                 hits.append((kind, engine))\r\n  790:             except ModuleNotFoundError as exc:\r\n  791:                 expected = f\"{package}.{requested}\"\r\n  792:                 if exc.name != expected:\r\n  793:                     errors.append(f\"{kind}: import failed: {exc}\")\r\n  794:                 else:\r\n  795:                     errors.append(f\"{kind}: no module {requested}\")\r\n  796:             except DiffomaticError as exc:\r\n  797:                 errors.append(f\"{kind}: {exc}\")\r\n  798:         if len(hits) != 1:\r\n  799:             detail = \"; \".join(errors) or \"no registered module\"\r\n  800:             if len(hits) > 1:\r\n  801:                 detail = \"identifier exists in both video and image registries\"\r\n  802:             raise UnsupportedGraphError(f\"{identifier}: {detail}\")\r\n  803:         _kind, engine = hits[0]\r\n  804:         yield engine\r\n  805: \r\n  806: \r\n  807: def _build_engine_graph(identifier: str, otr_root: str = OTR_ROOT) -> LoadedGraph:\r\n  808:     with resolved_engine(identifier, otr_root) as engine:\r\n  809:         graph, _fixture = _invoke_graph_builder(engine)\r\n  810:         return _normalise_dynamic_graph(engine, graph)\r\n  811: \r\n  812: \r\n  813: def _is_wire(value: Any) -> bool:\r\n  814:     \"\"\"A graph edge, distinguished from a literal two-item list by its TYPE.\r\n  815: \r\n  816:     OTR's ``wrapper_bridge.Wire`` is a 2-tuple subclass ``(src, slot)`` and the\r\n  817:     bridge itself checks it before any generic tuple; this mirrors that rule so\r\n  818:     a literal ``[\"a\", 0]`` parameter is never mistaken for wiring.\r\n  819:     \"\"\"\r\n  820:     return (\r\n  821:         isinstance(value, tuple)\r\n  822:         and type(value) is not tuple\r\n  823:         and len(value) == 2\r\n  824:         and isinstance(value[0], str)\r\n  825:         and isinstance(value[1], int)\r\n  826:         and not isinstance(value[1], bool)\r\n  827:     )\r\n  828: \r\n  829: \r\n  830: def _api_value(value: Any):\r\n  831:     \"\"\"Convert one builder input into JSON-native ComfyUI API form.\r\n  832: \r\n  833:     This exists INSTEAD of ``copy.deepcopy``.  ``Wire`` subclasses ``tuple``\r\n  834:     while taking two constructor arguments, so it inherits\r\n  835:     ``tuple.__getnewargs__`` and a deep copy rebuilds it as ``Wire(('pos', 0))``\r\n  836:     -- the whole wire slides into the ``src`` slot and comes back nested as\r\n  837:     ``(('pos', 0), 0)``.  The copy still walks, indexes and serialises like a\r\n  838:     wire, so the corruption is silent and lands as an unresolvable link at\r\n  839:     submit time.  Converting explicitly avoids the copy entirely.\r\n  840:     \"\"\"\r\n  841:     if _is_wire(value):\r\n  842:         return [str(value[0]), int(value[1])]\r\n  843:     if isinstance(value, dict):\r\n  844:         return {str(k): _api_value(v) for k, v in value.items()}\r\n  845:     if isinstance(value, (list, tuple)):\r\n  846:         return [_api_value(item) for item in value]\r\n  847:     return value\r\n  848: \r\n  849: \r\n  850: def _api_inputs(inputs: dict) -> dict:\r\n  851:     \"\"\"Builder inputs in HTTP-prompt form, dynamic dicts flattened to dot keys.\r\n  852: \r\n  853:     V3 dynamic inputs (``COMFY_DYNAMICCOMBO_V3``, autogrow) are addressed in\r\n  854:     the API prompt by dot-joined prefixes -- ``finalize_prefix`` in ComfyUI's\r\n  855:     ``comfy_api/latest/_io.py`` joins with ``\".\"`` and the executor resolves\r\n  856:     sub-inputs via those paths. The in-process bridge accepts the nested-dict\r\n  857:     authoring form instead, which is what engine builders emit -- submitting\r\n  858:     that dict verbatim leaves the argument unmapped and the node raises\r\n  859:     ``execute() missing 1 required positional argument`` (every lane 2 leg,\r\n  860:     first attempt, 2026-08-21). The flattening rule mirrors\r\n  861:     ``_flatten_params``: an inner key equal to the input's own name is the\r\n  862:     selector and keeps the bare name; every other key gains the dot prefix.\r\n  863:     \"\"\"\r\n  864:     out = {}\r\n  865: \r\n  866:     def emit(key, value):\r\n  867:         if isinstance(value, dict) and not _is_wire(value):\r\n  868:             if not value:\r\n  869:                 raise UnsupportedGraphError(\r\n  870:                     \"input %r is an empty dict; flattening would drop the \"\r\n  871:                     \"argument entirely and reproduce the unmapped-argument \"\r\n  872:                     \"failure the flattener exists to prevent\" % key)\r\n  873:             leaf = key.rsplit(\".\", 1)[-1]\r\n  874:             for inner_key, inner_value in value.items():\r\n  875:                 child = key if str(inner_key) == leaf else \"%s.%s\" % (key, inner_key)\r\n  876:                 emit(child, inner_value)\r\n  877:             return\r\n  878:         out[key] = _api_value(value)\r\n  879: \r\n  880:     for key, value in inputs.items():\r\n  881:         emit(str(key), value)\r\n  882:     return out\r\n  883: \r\n  884: \r\n  885: def build_api_graph(identifier: str, otr_root: str = OTR_ROOT,\r\n  886:                     allow_local: frozenset = frozenset()) -> tuple[dict, dict]:\r\n  887:     \"\"\"The engine's OWN graph in ComfyUI API form, literals and wires intact.\r\n  888: \r\n  889:     ``_build_engine_graph`` answers \"what does this engine DIFF like\": it\r\n  890:     flattens params to dotted comparison keys, drops empty containers and lifts\r\n  891:     wires out into ``edges``.  Every one of those is lossy for EXECUTION, so an\r\n  892:     A/B arm rebuilt from a ``LoadedGraph`` would carry quietly altered literals.\r\n  893:     This reads the raw builder output instead and changes exactly one thing --\r\n  894:     the logical class token becomes the concrete node class the engine's own\r\n  895:     ``_node_candidates`` declares.\r\n  896: \r\n  897:     Fails closed on a node the engine implements as a LOCAL Python class (the\r\n  898:     LTX sigma injectors): nothing is registered behind those, so emitting one\r\n  899:     would stage an arm that cannot execute over the HTTP API.\r\n  900:     \"\"\"\r\n  901:     with resolved_engine(identifier, otr_root) as engine:\r\n  902:         raw, fixture = _invoke_graph_builder(engine)\r\n  903:         mapping = _candidate_map(engine)\r\n  904:         internal = _internal_class_map(engine)\r\n  905:         declared = {name for choices in mapping.values() for name in choices}\r\n  906:         api = {}\r\n  907:         for node_id, node in raw.items():\r\n  908:             logical = node.get(\"class\")\r\n  909:             if logical in mapping:\r\n  910:                 class_type = mapping[logical][0]\r\n  911:             elif logical in internal:\r\n  912:                 if str(node_id) in allow_local:\r\n  913:                     # Explicit opt-in: the caller has DECLARED it will replace\r\n  914:                     # this node with a registered equivalent before submitting\r\n  915:                     # (the documented-ADAPT pattern, e.g. _SigmasFromValues ->\r\n  916:                     # ManualSigmas). The local name is emitted so a forgotten\r\n  917:                     # replacement still fails loudly at the server, and the\r\n  918:                     # provenance records the debt.\r\n  919:                     class_type = internal[logical]\r\n  920:                 else:\r\n  921:                     raise UnsupportedGraphError(\r\n  922:                         f\"{identifier}: node {node_id!r} resolves to local class \"\r\n  923:                         f\"{internal[logical]!r}, which is not a registered ComfyUI \"\r\n  924:                         \"node and cannot be submitted over the API\"\r\n  925:                     )\r\n  926:             elif logical in declared:\r\n  927:                 class_type = logical\r\n  928:             else:\r\n  929:                 raise UnsupportedGraphError(\r\n  930:                     f\"{identifier}: node {node_id!r} uses logical class \"\r\n  931:                     f\"{logical!r}, absent from the engine's _node_candidates\"\r\n  932:                 )\r\n  933:             inputs = node.get(\"inputs\") or {}\r\n  934:             if not isinstance(inputs, dict):\r\n  935:                 raise UnsupportedGraphError(\r\n  936:                     f\"{identifier}: node {node_id!r} inputs are \"\r\n  937:                     f\"{type(inputs).__name__}, not a dict\"\r\n  938:                 )\r\n  939:             api[str(node_id)] = {\r\n  940:                 \"class_type\": class_type,\r\n  941:                 \"inputs\": _api_inputs(inputs),\r\n  942:             }\r\n  943:         width, height = _declared_canvas(engine)\r\n  944:         provenance = {\r\n  945:             \"engine_id\": str(getattr(engine, \"name\", type(engine).__name__)),\r\n  946:             \"engine_class\": type(engine).__name__,\r\n  947:             \"engine_module\": type(engine).__module__,\r\n  948:             \"render_canvas\": [width, height],\r\n  949:             \"builder_signature\": str(inspect.signature(engine._build_graph)),\r\n  950:             \"builder_fixture_plan\": copy.deepcopy(fixture[\"plan\"]),\r\n  951:         }\r\n  952:         if allow_local:\r\n  953:             provenance[\"allowed_local_nodes\"] = sorted(allow_local)\r\n  954:     return api, provenance\r\n  955: \r\n  956: \r\n  957: _LEGACY_WIDGET_TYPES = {\"INT\", \"FLOAT\", \"STRING\", \"BOOLEAN\", \"COMBO\"}\r\n  958: \r\n  959: \r\n  960: def _enum_value(value):\r\n  961:     return getattr(value, \"value\", value)\r\n  962: \r\n  963: \r\n  964: def _dynamic_options(row: dict) -> list[dict]:\r\n  965:     spec = row.get(\"spec\") or {}\r\n  966:     options = spec.get(\"options\")\r\n  967:     if not isinstance(options, list):\r\n  968:         return []\r\n  969:     return [option for option in options\r\n  970:             if isinstance(option, dict) and \"key\" in option and \"inputs\" in option]\r\n  971: \r\n  972: \r\n  973: def _row_is_widget(row: dict) -> bool:\r\n  974:     spec = row.get(\"spec\") or {}\r\n  975:     if row.get(\"kind\") == \"v3\":\r\n  976:         return bool(_dynamic_options(row)) or \"default\" in spec or bool(\r\n  977:             spec.get(\"control_after_generate\")\r\n  978:         ) or (\r\n  979:             isinstance(spec.get(\"options\"), list)\r\n  980:             and not _dynamic_options(row)\r\n","exit_code":0,"status":"completed"}}
