{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'tools\\\\diffomatic.py'; \\\"===== \"'$f =====\"; if(-not (Test-Path -LiteralPath $f)){ \"MISSING\"; exit 0 }; $lines=Get-Content -LiteralPath $f; for($i=1; ($i -le 420) -and ($i -le $lines.Count); $i++){ '\"'{0,5}: {1}' -f \"'$i,$lines[$i-1] }'","aggregated_output":"===== tools\\diffomatic.py =====\r\n    1: \"\"\"Diff a shipped ComfyUI template against the graph an OTR engine runs.\r\n    2: \r\n    3: Diffomatic is deliberately a reporter, never a recipe editor.  Its important\r\n    4: contract is fail-closed: an engine that cannot be selected unambiguously, a\r\n    5: builder signature we do not understand, an unresolved logical node name, or an\r\n    6: empty parse is an ERROR.  None of those states may be printed as a clean 0/0\r\n    7: comparison.\r\n    8: \r\n    9: Usage::\r\n   10: \r\n   11:     python diffomatic.py --template OFFICIAL.json --ours eng_ltx25\r\n   12:                          [--recipe-py eng_ltx25.py,ltx25_recipe.py]\r\n   13:                          [--json receipt.json]\r\n   14: \r\n   15: Both UI-format and API-format JSON are accepted.  ``--ours eng_*`` imports the\r\n   16: registered OTR adapter and calls its pure ``_build_graph`` method; it does not\r\n   17: start ComfyUI, load a model, or touch the GPU.\r\n   18: \"\"\"\r\n   19: from __future__ import annotations\r\n   20: \r\n   21: import argparse\r\n   22: import ast\r\n   23: import copy\r\n   24: import functools\r\n   25: import hashlib\r\n   26: import importlib\r\n   27: import importlib.metadata\r\n   28: import inspect\r\n   29: import json\r\n   30: import os\r\n   31: import re\r\n   32: import sys\r\n   33: import textwrap\r\n   34: from collections import Counter, defaultdict\r\n   35: from contextlib import contextmanager\r\n   36: from dataclasses import dataclass, field\r\n   37: from typing import Any, Iterable\r\n   38: \r\n   39: \r\n   40: OTR_ROOT = r\"C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\"\r\n   41: \r\n   42: # Node classes whose values or mere presence can change the rendered result.\r\n   43: # Structural nodes remain in the report even when every input is a wire.\r\n   44: SIGNIFICANT = (\r\n   45:     \"sampler\", \"sigma\", \"schedul\", \"vaedecode\", \"addguide\", \"imgtovideo\",\r\n   46:     \"cropguides\", \"dualcfg\", \"emptyltxv\", \"conditioning\", \"createvideo\",\r\n   47:     \"latentupsampl\", \"latentupscale\", \"preprocess\", \"resize\", \"guider\",\r\n   48:     \"concatav\", \"separateav\", \"audiovae\", \"unetloader\", \"cliploader\",\r\n   49:     \"vaeloader\", \"ksampler\", \"noise\", \"cfg\", \"modalityguidance\",\r\n   50:     \"checkpointloader\", \"loraloader\", \"textencoderloader\", \"emptylatentaudio\",\r\n   51:     \"modelsampling\", \"audioencoder\", \"imagescale\", \"latentnoisemask\",\r\n   52:     \"solidmask\", \"textgenerate\", \"switch\", \"mathexpression\", \"primitive\",\r\n   53:     \"loadimage\", \"loadaudio\", \"savevideo\",\r\n   54: )\r\n   55: \r\n   56: # Cosmetic or deliberately per-run widgets.  Node presence is still retained.\r\n   57: IGNORE_KEYS = {\r\n   58:     \"control_after_generate\", \"batch_size\", \"device\", \"filename_prefix\",\r\n   59:     \"upload\", \"image\", \"text\",\r\n   60: }\r\n   61: \r\n   62: _ENGINE_ID = re.compile(\r\n   63:     r\"^(?:(?P<kind>video|image):)?(?P<identifier>[A-Za-z0-9_.-]+?)(?:\\.py)?$\"\r\n   64: )\r\n   65: _MISSING = object()\r\n   66: \r\n   67: \r\n   68: class DiffomaticError(RuntimeError):\r\n   69:     \"\"\"A comparison state that must never degrade to a clean report.\"\"\"\r\n   70: \r\n   71:     code = \"DIFFOMATIC_ERROR\"\r\n   72:     exit_code = 3\r\n   73: \r\n   74:     def __init__(self, message: str, *, counts: dict | None = None):\r\n   75:         super().__init__(message)\r\n   76:         self.counts = counts or {}\r\n   77: \r\n   78: \r\n   79: class UnsupportedGraphError(DiffomaticError):\r\n   80:     code = \"UNSUPPORTED_GRAPH\"\r\n   81:     exit_code = 3\r\n   82: \r\n   83: \r\n   84: class EmptyGraphError(DiffomaticError):\r\n   85:     code = \"EMPTY_GRAPH\"\r\n   86:     exit_code = 4\r\n   87: \r\n   88: \r\n   89: class MissingInputError(DiffomaticError):\r\n   90:     code = \"MISSING_INPUT\"\r\n   91:     exit_code = 2\r\n   92: \r\n   93: \r\n   94: class InternalDiffomaticError(DiffomaticError):\r\n   95:     code = \"INTERNAL_ERROR\"\r\n   96:     exit_code = 5\r\n   97: \r\n   98: \r\n   99: @dataclass(frozen=True)\r\n  100: class GraphNode:\r\n  101:     node_id: str\r\n  102:     class_type: str\r\n  103:     params: dict\r\n  104:     order: int\r\n  105:     boundary: bool = False\r\n  106: \r\n  107: \r\n  108: @dataclass(frozen=True)\r\n  109: class GraphEdge:\r\n  110:     source_id: str\r\n  111:     source_port: int\r\n  112:     target_id: str\r\n  113:     target_input: str\r\n  114: \r\n  115: \r\n  116: @dataclass(frozen=True)\r\n  117: class LoadedGraph:\r\n  118:     source: str\r\n  119:     source_kind: str\r\n  120:     nodes: list[tuple[str, dict, int]]\r\n  121:     total_nodes: int\r\n  122:     graph_nodes: tuple[GraphNode, ...] = ()\r\n  123:     edges: tuple[GraphEdge, ...] = ()\r\n  124:     scope: str = \"root\"\r\n  125:     provenance: dict = field(default_factory=dict)\r\n  126: \r\n  127:     @property\r\n  128:     def significant_nodes(self) -> int:\r\n  129:         return len(self.nodes)\r\n  130: \r\n  131:     def counts(self) -> dict:\r\n  132:         return {\r\n  133:             \"source\": self.source,\r\n  134:             \"source_kind\": self.source_kind,\r\n  135:             \"total\": self.total_nodes,\r\n  136:             \"significant\": self.significant_nodes,\r\n  137:             \"edges\": len(self.edges),\r\n  138:             \"scope\": self.scope,\r\n  139:             \"topology_digest\": _topology_digest(self.graph_nodes, self.edges),\r\n  140:         }\r\n  141: \r\n  142: \r\n  143: def _is_significant(class_type: str) -> bool:\r\n  144:     low = (class_type or \"\").lower()\r\n  145:     return any(token in low for token in SIGNIFICANT)\r\n  146: \r\n  147: \r\n  148: def _is_engine_identifier(source: str) -> bool:\r\n  149:     match = _ENGINE_ID.fullmatch(source or \"\")\r\n  150:     return bool(\r\n  151:         match\r\n  152:         and (match.group(\"kind\") or match.group(\"identifier\").startswith(\"eng_\"))\r\n  153:     )\r\n  154: \r\n  155: \r\n  156: def _wire_ref(value: Any, known_ids: set[str]) -> tuple[str, int] | None:\r\n  157:     \"\"\"Return a graph edge only when its source exists in this graph.\r\n  158: \r\n  159:     Comfy API wires and ordinary two-item literal lists share the same JSON\r\n  160:     shape.  Treating every ``[str, int]`` as a wire silently deletes legitimate\r\n  161:     parameter values, so graph membership is the deciding evidence.\r\n  162:     \"\"\"\r\n  163:     if not (\r\n  164:         isinstance(value, (list, tuple))\r\n  165:         and len(value) == 2\r\n  166:         and isinstance(value[0], str)\r\n  167:         and isinstance(value[1], int)\r\n  168:         and not isinstance(value[1], bool)\r\n  169:         and value[1] >= 0\r\n  170:         and value[0] in known_ids\r\n  171:     ):\r\n  172:         return None\r\n  173:     return value[0], value[1]\r\n  174: \r\n  175: \r\n  176: def _without_wires(value: Any, known_ids: set[str] | None = None):\r\n  177:     \"\"\"Remove graph topology from a value while retaining literal containers.\"\"\"\r\n  178:     if known_ids is not None and _wire_ref(value, known_ids) is not None:\r\n  179:         return _MISSING\r\n  180:     if isinstance(value, dict):\r\n  181:         clean = {}\r\n  182:         for key, item in value.items():\r\n  183:             stripped = _without_wires(item, known_ids)\r\n  184:             if stripped is not _MISSING:\r\n  185:                 clean[key] = stripped\r\n  186:         return clean if clean else _MISSING\r\n  187:     if isinstance(value, (list, tuple)):\r\n  188:         clean = []\r\n  189:         for item in value:\r\n  190:             stripped = _without_wires(item, known_ids)\r\n  191:             if stripped is not _MISSING:\r\n  192:                 clean.append(stripped)\r\n  193:         return clean if clean else _MISSING\r\n  194:     return value\r\n  195: \r\n  196: \r\n  197: def _literal_inputs(inputs: dict, known_ids: set[str] | None = None) -> dict:\r\n  198:     out = {}\r\n  199:     for key, value in (inputs or {}).items():\r\n  200:         stripped = _without_wires(value, known_ids)\r\n  201:         if stripped is not _MISSING:\r\n  202:             out[key] = stripped\r\n  203:     return out\r\n  204: \r\n  205: \r\n  206: def _split_graph_inputs(\r\n  207:     node_id: str, inputs: dict, known_ids: set[str]\r\n  208: ) -> tuple[dict, list[GraphEdge]]:\r\n  209:     params = {}\r\n  210:     edges = []\r\n  211:     for key, value in (inputs or {}).items():\r\n  212:         wire = _wire_ref(value, known_ids)\r\n  213:         if wire is not None:\r\n  214:             edges.append(GraphEdge(wire[0], wire[1], node_id, str(key)))\r\n  215:             continue\r\n  216:         stripped = _without_wires(value, known_ids)\r\n  217:         if stripped is not _MISSING:\r\n  218:             params[str(key)] = stripped\r\n  219:     return _flatten_params(params), edges\r\n  220: \r\n  221: \r\n  222: def _stable_json(value: Any) -> str:\r\n  223:     return json.dumps(\r\n  224:         value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str\r\n  225:     )\r\n  226: \r\n  227: \r\n  228: def _topology_digest(\r\n  229:     nodes: Iterable[GraphNode], edges: Iterable[GraphEdge]\r\n  230: ) -> str:\r\n  231:     \"\"\"ID-independent structural digest that changes on rewiring or port drift.\"\"\"\r\n  232:     nodes = tuple(nodes)\r\n  233:     edges = tuple(edges)\r\n  234:     if not nodes:\r\n  235:         return \"\"\r\n  236:     by_id = {node.node_id: node for node in nodes}\r\n  237:     if len(by_id) != len(nodes):\r\n  238:         raise UnsupportedGraphError(\"duplicate node IDs prevent topology proof\")\r\n  239:     for edge in edges:\r\n  240:         if edge.source_id not in by_id or edge.target_id not in by_id:\r\n  241:             raise UnsupportedGraphError(\r\n  242:                 f\"edge {edge} references a node outside the selected graph scope\"\r\n  243:             )\r\n  244: \r\n  245:     labels = {\r\n  246:         node.node_id: hashlib.sha256(\r\n  247:             _stable_json([node.class_type, node.params]).encode(\"utf-8\")\r\n  248:         ).hexdigest()\r\n  249:         for node in nodes\r\n  250:     }\r\n  251:     for _ in range(max(1, len(nodes))):\r\n  252:         updated = {}\r\n  253:         for node in nodes:\r\n  254:             incoming = sorted(\r\n  255:                 (edge.target_input, edge.source_port, labels[edge.source_id])\r\n  256:                 for edge in edges if edge.target_id == node.node_id\r\n  257:             )\r\n  258:             outgoing = sorted(\r\n  259:                 (edge.target_input, edge.source_port, labels[edge.target_id])\r\n  260:                 for edge in edges if edge.source_id == node.node_id\r\n  261:             )\r\n  262:             payload = [node.class_type, incoming, outgoing]\r\n  263:             updated[node.node_id] = hashlib.sha256(\r\n  264:                 _stable_json(payload).encode(\"utf-8\")\r\n  265:             ).hexdigest()\r\n  266:         if updated == labels:\r\n  267:             break\r\n  268:         labels = updated\r\n  269: \r\n  270:     canonical = {\r\n  271:         \"nodes\": sorted(labels.values()),\r\n  272:         \"edges\": sorted(\r\n  273:             (labels[edge.source_id], edge.source_port,\r\n  274:              labels[edge.target_id], edge.target_input)\r\n  275:             for edge in edges\r\n  276:         ),\r\n  277:     }\r\n  278:     return hashlib.sha256(_stable_json(canonical).encode(\"utf-8\")).hexdigest()\r\n  279: \r\n  280: \r\n  281: def _make_loaded_graph(\r\n  282:     source: str,\r\n  283:     source_kind: str,\r\n  284:     graph_nodes: Iterable[GraphNode],\r\n  285:     edges: Iterable[GraphEdge],\r\n  286:     *,\r\n  287:     scope: str = \"root\",\r\n  288:     provenance: dict | None = None,\r\n  289: ) -> LoadedGraph:\r\n  290:     graph_nodes = tuple(graph_nodes)\r\n  291:     edges = tuple(edges)\r\n  292:     # Compute now so malformed topology fails during loading, never at receipt\r\n  293:     # formatting after a comparison has already been presented as successful.\r\n  294:     _topology_digest(graph_nodes, edges)\r\n  295:     significant = [\r\n  296:         (node.class_type, node.params, node.order)\r\n  297:         for node in graph_nodes\r\n  298:         if not node.boundary and _is_significant(node.class_type)\r\n  299:     ]\r\n  300:     loaded = LoadedGraph(\r\n  301:         source,\r\n  302:         source_kind,\r\n  303:         significant,\r\n  304:         sum(not node.boundary for node in graph_nodes),\r\n  305:         graph_nodes,\r\n  306:         edges,\r\n  307:         scope,\r\n  308:         provenance or {},\r\n  309:     )\r\n  310:     if not loaded.total_nodes:\r\n  311:         raise EmptyGraphError(f\"{source}: parsed zero graph nodes\", counts=loaded.counts())\r\n  312:     if not loaded.nodes:\r\n  313:         raise EmptyGraphError(\r\n  314:             f\"{source}: parsed {loaded.total_nodes} nodes but zero were analyzable\",\r\n  315:             counts=loaded.counts(),\r\n  316:         )\r\n  317:     return loaded\r\n  318: \r\n  319: \r\n  320: def _legacy_schema_rows(declared: dict) -> list[dict]:\r\n  321:     rows = []\r\n  322:     for section in (\"required\", \"optional\"):\r\n  323:         values = declared.get(section, {})\r\n  324:         if not isinstance(values, dict):\r\n  325:             continue\r\n  326:         for input_id, raw in values.items():\r\n  327:             type_spec = raw[0] if isinstance(raw, (tuple, list)) and raw else raw\r\n  328:             options = (\r\n  329:                 raw[1]\r\n  330:                 if isinstance(raw, (tuple, list))\r\n  331:                 and len(raw) > 1\r\n  332:                 and isinstance(raw[1], dict)\r\n  333:                 else {}\r\n  334:             )\r\n  335:             rows.append({\r\n  336:                 \"id\": str(input_id),\r\n  337:                 \"kind\": \"legacy\",\r\n  338:                 \"type\": type_spec,\r\n  339:                 \"spec\": dict(options),\r\n  340:             })\r\n  341:     return rows\r\n  342: \r\n  343: \r\n  344: @functools.lru_cache(maxsize=1)\r\n  345: def resolve_node_schemas() -> dict[str, list[dict]]:\r\n  346:     \"\"\"Resolve enough schema detail to name positional UI widgets exactly.\r\n  347: \r\n  348:     A list of input names is insufficient: DynamicCombo widgets serialize a\r\n  349:     selector plus the selected option's child widgets, and seed widgets append\r\n  350:     a ``control_after_generate`` value.  Returning structured rows lets the\r\n  351:     decoder consume the exact serialized arity.  If a significant UI node has\r\n  352:     widgets but no usable schema, loading fails closed instead of inventing\r\n  353:     ``w0`` names or shifting a value onto a wired input.\r\n  354:     \"\"\"\r\n  355:     schemas: dict[str, list[dict]] = {}\r\n  356:     comfy_root = r\"C:\\Users\\jeffr\\ComfyUI-Installs\\ComfyUI\\ComfyUI\"\r\n  357:     if not os.path.exists(comfy_root):\r\n  358:         return schemas\r\n  359: \r\n  360:     import glob\r\n  361: \r\n  362:     sys.path.insert(0, comfy_root)\r\n  363:     try:\r\n  364:         try:\r\n  365:             comfy_nodes = importlib.import_module(\"nodes\")\r\n  366:             for name, cls in getattr(comfy_nodes, \"NODE_CLASS_MAPPINGS\", {}).items():\r\n  367:                 if not hasattr(cls, \"INPUT_TYPES\"):\r\n  368:                     continue\r\n  369:                 try:\r\n  370:                     declared = cls.INPUT_TYPES()\r\n  371:                     schemas[name] = _legacy_schema_rows(declared)\r\n  372:                 except Exception:\r\n  373:                     continue\r\n  374:         except Exception:\r\n  375:             pass\r\n  376: \r\n  377:         for folder in (\"comfy_extras\", \"comfy_api_nodes\"):\r\n  378:             folder_path = os.path.join(comfy_root, folder)\r\n  379:             if not os.path.isdir(folder_path):\r\n  380:                 continue\r\n  381:             for pyfile in glob.glob(os.path.join(folder_path, \"*.py\")):\r\n  382:                 module_name = f\"{folder}.{os.path.splitext(os.path.basename(pyfile))[0]}\"\r\n  383:                 try:\r\n  384:                     module = importlib.import_module(module_name)\r\n  385:                 except Exception:\r\n  386:                     continue\r\n  387:                 for obj in vars(module).values():\r\n  388:                     if not isinstance(obj, type):\r\n  389:                         continue\r\n  390:                     try:\r\n  391:                         if hasattr(obj, \"define_schema\"):\r\n  392:                             schema = obj.define_schema()\r\n  393:                             schemas[schema.node_id] = [\r\n  394:                                 {\r\n  395:                                     \"id\": str(item.id),\r\n  396:                                     \"kind\": \"v3\",\r\n  397:                                     \"spec\": dict(item.as_dict()),\r\n  398:                                 }\r\n  399:                                 for item in schema.inputs\r\n  400:                             ]\r\n  401:                         elif hasattr(obj, \"INPUT_TYPES\"):\r\n  402:                             declared = obj.INPUT_TYPES()\r\n  403:                             schemas[obj.__name__] = _legacy_schema_rows(declared)\r\n  404:                     except Exception:\r\n  405:                         continue\r\n  406:     finally:\r\n  407:         try:\r\n  408:             sys.path.remove(comfy_root)\r\n  409:         except ValueError:\r\n  410:             pass\r\n  411:     return schemas\r\n  412: \r\n  413: \r\n  414: def _flatten_params(params: dict) -> dict:\r\n  415:     \"\"\"Flatten dynamic input dictionaries into comparable dotted parameters.\"\"\"\r\n  416:     out = {}\r\n  417: \r\n  418:     def visit(prefix: str, value):\r\n  419:         if not isinstance(value, dict):\r\n  420:             out[prefix] = value\r\n","exit_code":0,"status":"completed"}}
