0:                     \"never a silent swap on a 16 GB default\"),\r\n  181:             },\r\n  182:         }, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\")\r\n  183:     print(\"[LANE] %s staged: %d fixtures x 2 arms\" % (LANE, len(FIXTURES)))\r\n  184:     return 0\r\n  185: \r\n  186: \r\n  187: if __name__ == \"__main__\":\r\n  188:     raise SystemExit(main())\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'staging\\\\lane4_wan_text_encoder\\\\render_arms.py'; \"'$start=1; $end=360; \"===== $f =====\"; $lines=Get-Content -LiteralPath $f; for($i=$start; ($i -le $end) -and ($i -le $lines.Count); $i++){ '\"'{0,5}: {1}' -f \"'$i,$lines[$i-1] }'","aggregated_output":"===== staging\\lane4_wan_text_encoder\\render_arms.py =====\r\n    1: \"\"\"Render lane 4: every fixture, two arms, two seeds, sequentially, one server.\r\n    2: \r\n    3: Same receipts discipline as lanes 1-3: live ``/object_info`` preflight for\r\n    4: every class and model filename (INCLUDING both encoder loaders, since the two\r\n    5: arms load different classes), purity re-proved on the graphs actually queued,\r\n    6: outputs read back from ``/history``, temporal stats per leg. Best effort per\r\n    7: the no-VRAM-ceremony ruling -- the fp8 encoder is ~2.6 GB larger than the GGUF\r\n    8: one, so an OOM on the official arm is a plain recorded fault, not a project.\r\n    9: \r\n   10: Seed node is ``KSampler.seed``; the terminal is ``vaedecode`` and a\r\n   11: ``SaveImage`` is appended identically to both arms (native 832x480 frames).\r\n   12: \r\n   13: THE CONTRAST IS A NODE CLASS SWAP, so the submit gate declares it explicitly\r\n   14: via ``--expect-class``. Every OTHER class change, and any wiring change at all,\r\n   15: still aborts the lane.\r\n   16: \r\n   17: usage: render_arms.py [fixture_key ...]      (default: every staged fixture)\r\n   18: \"\"\"\r\n   19: from __future__ import annotations\r\n   20: \r\n   21: import hashlib\r\n   22: import io\r\n   23: import json\r\n   24: import sys\r\n   25: import time\r\n   26: import urllib.error\r\n   27: import urllib.request\r\n   28: from pathlib import Path\r\n   29: \r\n   30: HERE = Path(__file__).resolve().parent\r\n   31: sys.path.insert(0, str(HERE.parents[1] / \"tools\"))\r\n   32: import purity_gate  # noqa: E402\r\n   33: import temporal_stats  # noqa: E402\r\n   34: \r\n   35: SERVER = \"http://127.0.0.1:8000\"\r\n   36: SEEDS = [42, 20260821]\r\n   37: ARMS = [\"ours\", \"official\"]\r\n   38: OUT_PREFIX = \"baseline_output/lane4_wan_text_encoder\"\r\n   39: LEG_TIMEOUT_S = 2 * 60 * 60\r\n   40: # class -> file-carrying inputs to confirm against the live enum options.\r\n   41: # BOTH encoder loaders are listed: the arms load different classes, and a lane\r\n   42: # whose candidate file is missing must fail at preflight, not at submit.\r\n   43: MODEL_INPUTS = {\r\n   44:     \"UnetLoaderGGUF\": [\"unet_name\"],\r\n   45:     \"CLIPLoaderGGUF\": [\"clip_name\"],\r\n   46:     \"CLIPLoader\": [\"clip_name\"],\r\n   47:     \"VAELoader\": [\"vae_name\"],\r\n   48:     \"LoadImage\": [\"image\"],\r\n   49: }\r\n   50: \r\n   51: \r\n   52: def get_json(url, timeout=90):\r\n   53:     with urllib.request.urlopen(url, timeout=timeout) as response:\r\n   54:         return json.loads(response.read().decode(\"utf-8\"))\r\n   55: \r\n   56: \r\n   57: def post_json(url, payload, timeout=60):\r\n   58:     data = json.dumps(payload).encode(\"utf-8\")\r\n   59:     request = urllib.request.Request(\r\n   60:         url, data=data, headers={\"Content-Type\": \"application/json\"})\r\n   61:     with urllib.request.urlopen(request, timeout=timeout) as response:\r\n   62:         return json.loads(response.read().decode(\"utf-8\"))\r\n   63: \r\n   64: \r\n   65: def enum_options(spec):\r\n   66:     \"\"\"Selectable values of a combo input, legacy or V3 shape.\r\n   67: \r\n   68:     Legacy: ``[[opt, ...], {...}]``. V3: ``[\"COMBO\", {\"options\": [opt, ...]}]``\r\n   69:     -- LatentUpscaleModelLoader ships the V3 shape and the legacy-only reader\r\n   70:     called its installed model missing (lane 2 preflight, 2026-08-21).\r\n   71:     \"\"\"\r\n   72:     if isinstance(spec, list) and spec:\r\n   73:         if isinstance(spec[0], list):\r\n   74:             return list(spec[0])\r\n   75:         if spec[0] == \"COMBO\" and len(spec) > 1 and isinstance(spec[1], dict):\r\n   76:             return list(spec[1].get(\"options\") or [])\r\n   77:     return []\r\n   78: \r\n   79: \r\n   80: def preflight(graphs, object_info):\r\n   81:     faults = []\r\n   82:     seen = set()\r\n   83:     for graph in graphs.values():\r\n   84:         for node_id, node in graph.items():\r\n   85:             class_type = node[\"class_type\"]\r\n   86:             if class_type not in object_info:\r\n   87:                 faults.append(\r\n   88:                     \"class %r (node %r) absent from /object_info\" % (class_type, node_id))\r\n   89:                 continue\r\n   90:             seen.add(class_type)\r\n   91:             for input_name in MODEL_INPUTS.get(class_type, []):\r\n   92:                 wanted = node[\"inputs\"].get(input_name)\r\n   93:                 spec = ((object_info[class_type].get(\"input\") or {}).get(\"required\") or {})\r\n   94:                 options = enum_options(spec.get(input_name))\r\n   95:                 if not options:\r\n   96:                     faults.append(\"%s.%s exposes no selectable values\"\r\n   97:                                   % (class_type, input_name))\r\n   98:                 elif wanted not in options:\r\n   99:                     faults.append(\"%s.%s=%r is not installed (server offers %d)\"\r\n  100:                                   % (class_type, input_name, wanted, len(options)))\r\n  101:     for class_type in sorted(seen):\r\n  102:         print(\"[OBJECT_INFO] %s: present\" % class_type)\r\n  103:     return faults\r\n  104: \r\n  105: \r\n  106: def leg_prefix(fixture, arm, seed):\r\n  107:     return \"%s/%s/%s_seed%d/frame\" % (OUT_PREFIX, fixture, arm, seed)\r\n  108: \r\n  109: \r\n  110: def build_submission(fixture, arm, seed):\r\n  111:     graph = json.loads(io.open(HERE / fixture / (\"arm_%s.json\" % arm),\r\n  112:                                encoding=\"utf-8\").read())\r\n  113:     graph[\"ksampler\"][\"inputs\"][\"seed\"] = seed\r\n  114:     graph[\"save\"] = {\r\n  115:         \"class_type\": \"SaveImage\",\r\n  116:         \"inputs\": {\"images\": [\"vaedecode\", 0],\r\n  117:                    \"filename_prefix\": leg_prefix(fixture, arm, seed)},\r\n  118:     }\r\n  119:     return graph\r\n  120: \r\n  121: \r\n  122: def gate_submissions(fixture, seed, submitted, receipts, manifest):\r\n  123:     paths = {}\r\n  124:     for arm, graph in submitted.items():\r\n  125:         path = receipts / (\"submitted_%s_seed%d.json\" % (arm, seed))\r\n  126:         text = json.dumps(graph, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\"\r\n  127:         io.open(path, \"w\", encoding=\"utf-8\", newline=\"\\n\").write(text)\r\n  128:         manifest[path.name] = hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\r\n  129:         paths[arm] = path\r\n  130:     io.open(receipts / \"ARMS.sha256\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  131:         \"\".join(\"%s  %s\\n\" % (manifest[n], n) for n in sorted(manifest)))\r\n  132:     declared = [\r\n  133:         'clip.clip_name=\"umt5_xxl_fp8_e4m3fn_scaled.safetensors\"',\r\n  134:         'save.filename_prefix=\"%s\"' % leg_prefix(fixture, \"official\", seed),\r\n  135:     ]\r\n  136:     argv = [str(paths[\"ours\"]), str(paths[\"official\"])]\r\n  137:     for item in declared:\r\n  138:         argv += [\"--expect\", item]\r\n  139:     argv += [\"--expect-class\", \"clip=CLIPLoader\"]\r\n  140:     print(\"[SUBMIT GATE] %s seed %d\" % (fixture, seed))\r\n  141:     return purity_gate.main(argv) == 0\r\n  142: \r\n  143: \r\n  144: def wait_for_leg(prompt_id, started):\r\n  145:     while True:\r\n  146:         if time.time() - started > LEG_TIMEOUT_S:\r\n  147:             return {\"status\": \"TIMEOUT\", \"outputs\": {}, \"messages\": []}\r\n  148:         try:\r\n  149:             history = get_json(\"%s/history/%s\" % (SERVER, prompt_id))\r\n  150:         except (urllib.error.URLError, TimeoutError) as exc:\r\n  151:             return {\"status\": \"SERVER GONE: %s\" % exc, \"outputs\": {}, \"messages\": []}\r\n  152:         except json.JSONDecodeError:\r\n  153:             # A restarting server can answer with an HTML error page; that is\r\n  154:             # a hiccup to ride out, not a reason to abandon the queued legs.\r\n  155:             time.sleep(10)\r\n  156:             continue\r\n  157:         entry = history.get(prompt_id)\r\n  158:         if entry:\r\n  159:             status = entry.get(\"status\") or {}\r\n  160:             if status.get(\"completed\") or status.get(\"status_str\") in (\"success\", \"error\"):\r\n  161:                 return {\"status\": status.get(\"status_str\", \"unknown\"),\r\n  162:                         \"outputs\": entry.get(\"outputs\") or {},\r\n  163:                         \"messages\": status.get(\"messages\") or []}\r\n  164:         time.sleep(10)\r\n  165: \r\n  166: \r\n  167: def main():\r\n  168:     lane = json.loads(io.open(HERE / \"LANE.json\", encoding=\"utf-8\").read())\r\n  169:     wanted = sys.argv[1:] or sorted(lane[\"fixtures\"])\r\n  170:     unknown = [k for k in wanted if k not in lane[\"fixtures\"]]\r\n  171:     if unknown:\r\n  172:         print(\"[FAIL] unknown fixture(s): %s\" % unknown)\r\n  173:         return 1\r\n  174: \r\n  175:     print(\"[SERVER] %s\" % SERVER)\r\n  176:     print(\"[FIXTURES] %s\" % \", \".join(wanted))\r\n  177:     object_info = get_json(\"%s/object_info\" % SERVER, timeout=300)\r\n  178:     print(\"[OBJECT_INFO] %d classes registered\" % len(object_info))\r\n  179: \r\n  180:     # The sigmas ADAPT depends on ManualSigmas accepting a string: confirm the\r\n  181:     # contract on THIS server before anything queues.\r\n  182:     manual = object_info.get(\"ManualSigmas\")\r\n  183:     if not manual:\r\n  184:         print(\"[FAIL] ManualSigmas absent from /object_info; the ADAPT is void\")\r\n  185:         return 1\r\n  186:     sig_spec = ((manual.get(\"input\") or {}).get(\"required\") or {}).get(\"sigmas\")\r\n  187:     print(\"[ADAPT CHECK] ManualSigmas.sigmas spec head: %s\"\r\n  188:           % json.dumps(sig_spec)[:120])\r\n  189: \r\n  190:     plan = {}\r\n  191:     for fixture in wanted:\r\n  192:         for seed in SEEDS:\r\n  193:             for arm in ARMS:\r\n  194:                 plan[(fixture, arm, seed)] = build_submission(fixture, arm, seed)\r\n  195: \r\n  196:     named = {\"%s_%s_%d\" % k: g for k, g in plan.items()}\r\n  197:     faults = preflight(named, object_info)\r\n  198:     if faults:\r\n  199:         for fault in sorted(set(faults)):\r\n  200:             print(\"[FAIL] %s\" % fault)\r\n  201:         print(\"[PREFLIGHT] FAILED -- nothing queued.\")\r\n  202:         return 1\r\n  203:     print(\"[PREFLIGHT] PASSED -- every class and model filename is live on this server.\")\r\n  204: \r\n  205:     for fixture in wanted:\r\n  206:         receipts = HERE / fixture / \"render\"\r\n  207:         receipts.mkdir(parents=True, exist_ok=True)\r\n  208:         manifest = {}\r\n  209:         for seed in SEEDS:\r\n  210:             arms_for_seed = {arm: plan[(fixture, arm, seed)] for arm in ARMS}\r\n  211:             if not gate_submissions(fixture, seed, arms_for_seed, receipts, manifest):\r\n  212:                 print(\"[FAIL] %s seed %d is not pure. Nothing queued.\" % (fixture, seed))\r\n  213:                 return 1\r\n  214: \r\n  215:     legs = []\r\n  216:     for fixture in wanted:\r\n  217:         receipts = HERE / fixture / \"render\"\r\n  218:         fixture_legs = []\r\n  219:         for seed in SEEDS:\r\n  220:             for arm in ARMS:\r\n  221:                 graph = plan[(fixture, arm, seed)]\r\n  222:                 text = json.dumps(graph, indent=2, sort_keys=True,\r\n  223:                                   ensure_ascii=False) + \"\\n\"\r\n  224:                 digest = hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\r\n  225:                 label = \"%s/%s_seed%d\" % (fixture, arm, seed)\r\n  226:                 print(\"\")\r\n  227:                 print(\"[LEG] %s  sha256=%s  encoder=%s seed=%s\"\r\n  228:                       % (label, digest[:16],\r\n  229:                          graph[\"clip\"][\"inputs\"][\"clip_name\"],\r\n  230:                          graph[\"ksampler\"][\"inputs\"][\"seed\"]))\r\n  231:                 started = time.time()\r\n  232:                 try:\r\n  233:                     queued = post_json(\"%s/prompt\" % SERVER, {\"prompt\": graph})\r\n  234:                 except urllib.error.HTTPError as exc:\r\n  235:                     detail = exc.read().decode(\"utf-8\", \"replace\")[:2000]\r\n  236:                     print(\"[FAULT] %s: submit rejected: %s\" % (label, detail))\r\n  237:                     fixture_legs.append({\"leg\": label, \"fixture\": fixture,\r\n  238:                                          \"arm\": arm, \"seed\": seed,\r\n  239:                                          \"sha256\": digest, \"status\": \"REJECTED\",\r\n  240:                                          \"detail\": detail})\r\n  241:                     legs.append(fixture_legs[-1])\r\n  242:                     continue\r\n  243:                 prompt_id = queued.get(\"prompt_id\")\r\n  244:                 print(\"[QUEUED] %s prompt_id=%s\" % (label, prompt_id))\r\n  245:                 result = wait_for_leg(prompt_id, started)\r\n  246:                 elapsed = round(time.time() - started, 1)\r\n  247:                 images = []\r\n  248:                 for output in (result[\"outputs\"] or {}).values():\r\n  249:                     images.extend(output.get(\"images\") or [])\r\n  250:                 print(\"[DONE] %s status=%s frames=%d elapsed=%ss\"\r\n  251:                       % (label, result[\"status\"], len(images), elapsed))\r\n  252:                 if result[\"status\"] != \"success\":\r\n  253:                     print(\"[FAULT] %s: %s\"\r\n  254:                           % (label, json.dumps(result.get(\"messages\"))[:1500]))\r\n  255:                 record = {\r\n  256:                     \"leg\": label, \"fixture\": fixture, \"arm\": arm, \"seed\": seed,\r\n  257:                     \"sha256\": digest, \"prompt_id\": prompt_id,\r\n  258:                     \"status\": result[\"status\"], \"elapsed_s\": elapsed,\r\n  259:                     \"frame_count\": len(images),\r\n  260:                     \"subfolder\": images[0][\"subfolder\"] if images else None,\r\n  261:                     \"first_frame\": images[0][\"filename\"] if images else None,\r\n  262:                     \"last_frame\": images[-1][\"filename\"] if images else None,\r\n  263:                     \"messages\": result.get(\"messages\", []),\r\n  264:                 }\r\n  265:                 if result[\"status\"] == \"success\" and record[\"subfolder\"]:\r\n  266:                     record[\"temporal\"] = temporal_stats.leg_stats(\r\n  267:                         temporal_stats.COMFY_OUTPUT / record[\"subfolder\"])\r\n  268:                     print(\"[TEMPORAL] %s mean=%.3f max=%.3f\"\r\n  269:                           % (label, record[\"temporal\"][\"mean_abs_delta\"],\r\n  270:                              record[\"temporal\"][\"max_abs_delta\"]))\r\n  271:                 fixture_legs.append(record)\r\n  272:                 legs.append(record)\r\n  273:                 io.open(receipts / \"RENDER.json\", \"w\", encoding=\"utf-8\",\r\n  274:                         newline=\"\\n\").write(\r\n  275:                     json.dumps({\"server\": SERVER, \"fixture\": fixture,\r\n  276:                                 \"seeds\": SEEDS, \"arms\": ARMS,\r\n  277:                                 \"output_prefix\": OUT_PREFIX, \"fps\": 25,\r\n  278:                                 \"legs\": fixture_legs},\r\n  279:                                indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\")\r\n  280: \r\n  281:     ok = sum(1 for leg in legs if leg[\"status\"] == \"success\")\r\n  282:     print(\"\")\r\n  283:     print(\"[RENDER] %d/%d leg(s) succeeded.\" % (ok, len(legs)))\r\n  284:     for leg in legs:\r\n  285:         print(\"  %-30s %-10s frames=%s elapsed=%ss\"\r\n  286:               % (leg[\"leg\"], leg[\"status\"], leg.get(\"frame_count\"),\r\n  287:                  leg.get(\"elapsed_s\")))\r\n  288:     return 0 if ok == len(legs) else 2\r\n  289: \r\n  290: \r\n  291: if __name__ == \"__main__\":\r\n  292:     sys.exit(main())\r\n","exit_code":0,"status":"completed"}}
