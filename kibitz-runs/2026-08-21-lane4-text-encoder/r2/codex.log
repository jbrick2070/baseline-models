{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'C:\\\\Users\\\\jeffr\\\\Documents\\\\ComfyUI\\\\custom_nodes\\\\ComfyUI-OldTimeRadio\\\\nodes\\\\_otr_video_engines\\\\eng_wan_ti2v.py'; \\\"===== \"'$f =====\"; if(-not(Test-Path -LiteralPath $f)){ \"MISSING\"; exit 0 }; $lines=Get-Content -LiteralPath $f; for($i=150; ($i -le 320) -and ($i -le $lines.Count); $i++){ '\"'{0,5}: {1}' -f \"'$i,$lines[$i-1] }'","aggregated_output":"  150: _TI2V_DEFAULT_UNET = \"Wan2.2-TI2V-5B-Q5_K_M.gguf\"\r\n  151: #: Floor default umt5 CLIP = the GGUF encoder (2026-06-18 roundtable). The official\r\n  152: #: fp8 (umt5_xxl_fp8_e4m3fn_scaled.safetensors) throws Float8_e4m3fn on Mac MPS\r\n  153: #: (ComfyUI #9255); GGUF dequantizes to fp16 -> the cross-platform 8GB path. Override\r\n  154: #: with OTR_WAN_TI2V_CLIP_NAME (+ OTR_WAN_TI2V_CLIP_LOADER) for an fp16 safetensors.\r\n  155: _TI2V_DEFAULT_CLIP = \"umt5-xxl-encoder-Q5_K_M.gguf\"\r\n  156: # Frame budgeting (2026-06-18 CLIP-FILL roundtable, supersedes the static 8GB\r\n  157: # floor): the old code hard-CLAMPED every clip to 17 frames (0.68s @ 25fps) so a\r\n  158: # ~280-frame beat froze after 0.68s (the composite held the last frame). The fix\r\n  159: # PREDICTS the VRAM-affordable length per beat via motion_common.\r\n  160: # compute_real_frame_budget (a zero-cost mem_get_info read + a cost model -- never\r\n  161: # react-to-OOM) bounded by the beat's audio-derived target, then the render\r\n  162: # ping-pong-extends that short render up to the full target so the beat is FILLED\r\n  163: # with motion. _TI2V_MIN_FRAMES is the motion floor (always >= this many 4n+1\r\n  164: # frames of real motion); _TI2V_MAX_FRAMES is the absolute hard cap;\r\n  165: # OTR_WAN_TI2V_MAX_FRAMES (server boot env) or the tier profile's\r\n  166: # video.max_render_frames (ledger-stamped, the production channel) lets a\r\n  167: # tiny/8GB card pin a lower hard cap.\r\n  168: _TI2V_MIN_FRAMES = 17\r\n  169: _TI2V_DEFAULT_FRAMES = 17\r\n  170: _TI2V_MAX_FRAMES = 177\r\n  171: #: Reference render canvas used when _floor_length is called without explicit dims\r\n  172: #: (matches OTR_VIDEO_LANDSCAPE_CANVAS / the cost-model telemetry reference).\r\n  173: _TI2V_COST_REF_W = 1472\r\n  174: _TI2V_COST_REF_H = 832\r\n  175: \r\n  176: #: The defined recipe-receipt string threaded into the manifest.\r\n  177: #:\r\n  178: #: THE VERSION LIVES IN THE STRING, not in a separate constant. This value rides\r\n  179: #: ``_clip_from_raw`` -> the manifest row -> the render-batch receipt ->\r\n  180: #: ``stamp_durable(meta.render_engines)``, so it is what a PUBLISHED EPISODE's\r\n  181: #: DURABLE LEDGER can be asked \"which recipe rendered you\". Before this chunk a\r\n  182: #: WAN clip stamped ``recipe: None`` -- there was not even a wrong receipt to\r\n  183: #: catch a drift with. A bare version constant that never reached this string\r\n  184: #: would leave the recipe invisible to every consumer that matters.\r\n  185: RECIPE_WAN_TI2V = \"wan22_ti2v_5b_i2v_single_pass_v1\"\r\n  186: \r\n  187: #: THE CONSENT ACT that re-opens this adapter's recipe knobs. PER ADAPTER, not\r\n  188: #: shared with ``wan_i2v``: one switch for both tiers would stamp a\r\n  189: #: ``+prequalification`` receipt on a clip that had rendered with the frozen\r\n  190: #: recipe, and a receipt that lies in the safer direction still lies.\r\n  191: PREQUALIFICATION_ENV = \"OTR_WAN_TI2V_PREQUALIFICATION\"\r\n  192: \r\n  193: #: THE FROZEN wan_ti2v RECIPE, v1 (LANE 1, 2026-07-27).\r\n  194: #:\r\n  195: #: WHAT v1 IS, STATED HONESTLY: these are TODAY'S SHIPPED DEFAULTS, lifted\r\n  196: #: verbatim from the env fallbacks they replace -- NOT a measured selection.\r\n  197: #: No WAN sweep has run. Freezing them is behaviour-preserving on any box that\r\n  198: #: set nothing, and it is reversible: a prequalification run measures and\r\n  199: #: produces v2 (bump the version INSIDE ``RECIPE_WAN_TI2V`` and add a new dict;\r\n  200: #: never edit a versioned dict in place, or receipts already on disk stop being\r\n  201: #: interpretable).\r\n  202: #:\r\n  203: #: ``max_frames`` IS DELIBERATELY NOT HERE. It is a render-length CEILING, and\r\n  204: #: unlike the ltx tier's it is a LIVE SHIPPED CHANNEL: ``otr_8gb_wan.json`` sets\r\n  205: #: both ``launch.env.OTR_WAN_TI2V_MAX_FRAMES`` and ``video.max_render_frames``.\r\n  206: #: Folding it into the recipe would silently retire the 8GB tier's launch\r\n  207: #: contract (``PBUG-20260723-02``, the bug this freeze descends from).\r\n  208: WAN_TI2V_RECIPE_V1 = {\r\n  209:     \"steps\": 30,\r\n  210:     \"cfg\": 5.0,\r\n  211:     #: ModelSamplingSD3 sigma shift; 5.0 is the 5B value (the 14B uses 8.0).\r\n  212:     \"shift\": 5.0,\r\n  213:     \"sampler\": \"euler\",\r\n  214:     \"scheduler\": \"simple\",\r\n  215:     #: The negative conditioning text. A RENDER INPUT, so it belongs here for\r\n  216:     #: the same reason the samplers do: read from ``os.environ`` it made two\r\n  217:     #: boxes produce visibly different clips that both stamped the same receipt.\r\n  218:     #: This adapter has no per-shot negative channel -- ``_build_graph`` reads\r\n  219:     #: only this -- so before the freeze the server's boot was its SOLE author.\r\n  220:     \"negative\": _WAN_DEFAULT_NEGATIVE,\r\n  221:     #: Tiled decode is ON for this tier: the video-VAE decode is a top VRAM-peak\r\n  222:     #: driver at 8GB. (The ltx tier measured the same direction on 2026-07-27 --\r\n  223:     #: tiled holds the peak FLAT across clip length where untiled climbs with it.\r\n  224:     #: That is ltx's measurement, not this adapter's, so it is context for a\r\n  225:     #: future WAN sweep and not a claim about these numbers.)\r\n  226:     \"tiled_vae\": True,\r\n  227:     #: The tiled-decode geometry, frozen with the flag that reaches it: the day\r\n  228:     #: a measured v2 changes tiling is the day four boot-environment values\r\n  229:     #: would otherwise start deciding what a published clip looks like.\r\n  230:     \"vae_tile\": 256,\r\n  231:     \"vae_overlap\": 64,\r\n  232:     \"vae_temporal\": 16,\r\n  233:     \"vae_temporal_overlap\": 8,\r\n  234: }\r\n  235: \r\n  236: #: THE ONE NAME EVERY CONSUMER READS. Bumping a recipe is repointing this and\r\n  237: #: the version inside ``RECIPE_WAN_TI2V`` -- never editing a versioned dict.\r\n  238: WAN_TI2V_RECIPE = WAN_TI2V_RECIPE_V1\r\n  239: \r\n  240: #: The env var each frozen field was read from, kept so the demotion can NAME\r\n  241: #: what it is ignoring. Presence is all this map is used for outside the consent\r\n  242: #: act -- see ``wan_recipe.ignored_override_keys``.\r\n  243: _RECIPE_ENV_KEYS = {\r\n  244:     \"steps\": \"OTR_WAN_TI2V_STEPS\",\r\n  245:     \"cfg\": \"OTR_WAN_TI2V_CFG\",\r\n  246:     \"shift\": \"OTR_WAN_TI2V_SHIFT\",\r\n  247:     \"sampler\": \"OTR_WAN_TI2V_SAMPLER\",\r\n  248:     \"scheduler\": \"OTR_WAN_TI2V_SCHEDULER\",\r\n  249:     \"negative\": \"OTR_WAN_TI2V_NEGATIVE\",\r\n  250:     \"tiled_vae\": \"OTR_WAN_TI2V_TILED_VAE\",\r\n  251:     \"vae_tile\": \"OTR_WAN_TI2V_VAE_TILE\",\r\n  252:     \"vae_overlap\": \"OTR_WAN_TI2V_VAE_OVERLAP\",\r\n  253:     \"vae_temporal\": \"OTR_WAN_TI2V_VAE_TEMPORAL\",\r\n  254:     \"vae_temporal_overlap\": \"OTR_WAN_TI2V_VAE_TEMPORAL_OVERLAP\",\r\n  255: }\r\n  256: \r\n  257: \r\n  258: #: S1 (2026-07-25) per-model still plan for wan_ti2v (spec section 3,\r\n  259: #: Shape A -- scene spine). FILE-LOCAL, fully declared (no cross-module\r\n  260: #: sharing per the spec's \"no inheritance or shared defaults\" rule).\r\n  261: #: scene_open + scene_beat + scene_character all WIDE + required=always;\r\n  262: #: portrait per subject at the engine's aspect (inherit_engine), not\r\n  263: #: required. Nothing reads the plan at S1 -- S2 wires it in.\r\n  264: _WAN_TI2V_STILL_PLAN = (\r\n  265:     StillPlanRow(kind=\"scene_open\", cardinality=\"per_beat\",\r\n  266:                  target_class=\"scene\", aspect=\"wide\", required=\"always\",\r\n  267:                  framing_geometry=(\r\n  268:                      \"full-frame macro, centered subject\"),\r\n  269:                  style_tail_policy=\"full\"),\r\n  270:     StillPlanRow(kind=\"scene_beat\", cardinality=\"per_beat\",\r\n  271:                  target_class=\"scene\", aspect=\"wide\", required=\"always\",\r\n  272:                  framing_geometry=(\r\n  273:                      (\"cinematic three-quarter framing, people shown with \"\r\n  274:                       \"full heads and clear headroom inside frame, faces \"\r\n  275:                       \"unobstructed, balanced composition\")),\r\n  276:                  style_tail_policy=\"full\"),\r\n  277:     StillPlanRow(kind=\"scene_character\", cardinality=\"per_beat\",\r\n  278:                  target_class=\"scene\", aspect=\"wide\", required=\"always\",\r\n  279:                  framing_geometry=(\r\n  280:                      (\"cinematic medium shot, the character framed within a \"\r\n  281:                       \"wide 16:9 environment, full head and shoulders with \"\r\n  282:                       \"clear headroom inside frame, face unobstructed, \"\r\n  283:                       \"balanced landscape composition\")),\r\n  284:                  style_tail_policy=\"full\"),\r\n  285:     StillPlanRow(kind=\"portrait\", cardinality=\"per_subject\",\r\n  286:                  target_class=\"portrait\", aspect=\"inherit_engine\",\r\n  287:                  required=\"never\",\r\n  288:                  framing_geometry=(\"in-character cinematic medium shot, head \"\r\n  289:                                    \"and shoulders, face clearly visible, \"\r\n  290:                                    \"subject centred with natural headroom \"\r\n  291:                                    \"above the head (never crop the top of the \"\r\n  292:                                    \"head)\"),\r\n  293:                  style_tail_policy=\"full\"),\r\n  294: )\r\n  295: \r\n  296: \r\n  297: @register\r\n  298: class WanTi2vEngine(_WS.WanInitImageMixin, _MC.MotionEngineBase):\r\n  299:     \"\"\"The wan_ti2v 5B image->video adapter (8GB tier; in-process, sidecar_optional).\"\"\"\r\n  300: \r\n  301:     name = \"wan_ti2v\"\r\n  302:     family = \"image_to_video\"\r\n  303:     #: Still-aspect identity (2026-06-17): Wan TI2V renders 16:9, so the director\r\n  304:     #: mints a WIDE init still (non-HuMo, non-mesh-portrait).\r\n  305:     render_aspect = \"wide\"\r\n  306:     #: S1 per-model still plan (see ``_WAN_TI2V_STILL_PLAN`` above).\r\n  307:     still_plan = _WAN_TI2V_STILL_PLAN\r\n  308:     # FLEXIBLE (operator 2026-06-18): eligible for EVERY role -- role_compat is the\r\n  309:     # real gate (it admits wan_ti2v only where the role supplies the required\r\n  310:     # init_image: announcer/music/character/retired_role_a do; the pure background_\r\n  311:     # abstract floor does not, so it's correctly excluded there). Opening `roles`\r\n  312:     # lets the operator pick wan_ti2v for the announcer slot (it animates that beat's\r\n  313:     # selected still); the required_inputs check still prevents a truly broken pick.\r\n  314:     roles = ROLES\r\n  315:     default_roles = ()\r\n  316:     required_inputs = (\"init_image\",)\r\n  317:     # ---- THE RECIPE SEAM (kibitz r2 MF2 / r4, 2026-08-01) ----------------- #\r\n  318:     #: These five name the module-level constants this adapter's recipe accessors\r\n  319:     #: used to read DIRECTLY. They are CLASS-LEVEL on purpose: a subclass (see\r\n  320:     #: eng_fastwan_8gb) shares this adapter's whole 5B substrate -- prepare, the\r\n","exit_code":0,"status":"completed"}}
