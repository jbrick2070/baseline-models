mt5_xxl_fp8_e4m3fn_scaled.safetensors\",\r\n   13:         \"type\": \"wan\"\r\n   14:       }\r\n   15:     },\r\n   16:     \"ours\": {\r\n   17:       \"class_type\": \"CLIPLoaderGGUF\",\r\n   18:       \"inputs\": {\r\n   19:         \"clip_name\": \"umt5-xxl-encoder-Q5_K_M.gguf\",\r\n   20:         \"type\": \"wan\"\r\n   21:       }\r\n   22:     }\r\n   23:   },\r\n   24:   \"engine\": \"eng_wan_ti2v\",\r\n   25:   \"fixture\": \"crowd\",\r\n   26:   \"image\": \"lane1_crowd.png\",\r\n   27:   \"lane\": \"lane4_wan_text_encoder\",\r\n   28:   \"prompt\": \"A crowded 1950s tent hall at night, dozens of people shoulder to shoulder watching a large wooden valve radio with a chrome antenna and glowing vacuum tubes on a table in the foreground, warm lantern light overhead, a lit doorway beyond the crowd, only subtle breathing, small head turns in the crowd and a faint flicker in the tube filaments, static locked-off camera, single continuous shot, no cut, no scene change, no camera move.\",\r\n   29:   \"role\": \"hard content, countable prompt demands (faces, tubes, meter ticks)\",\r\n   30:   \"wiring_note\": \"encoder feeds ['neg', 'pos'] in BOTH arms; any wiring delta is a staging fault\"\r\n   31: }\r\n===== staging\\lane4_wan_text_encoder\\testcard_motion\\STAGING.json =====\r\n    1: {\r\n    2:   \"arm_sha256\": {\r\n    3:     \"official\": \"8051a4bba06db69c11460a2d7b658586e7314c52069ffec8e1d44014e22edbf6\",\r\n    4:     \"ours\": \"ad59b2b80dc88a600cbb5efe79cfb0ceff5022c5dbfa6fa47200b746ccc9722c\"\r\n    5:   },\r\n    6:   \"declared_contrast\": {\r\n    7:     \"kind\": \"node class swap\",\r\n    8:     \"node\": \"clip\",\r\n    9:     \"official\": {\r\n   10:       \"class_type\": \"CLIPLoader\",\r\n   11:       \"inputs\": {\r\n   12:         \"clip_name\": \"umt5_xxl_fp8_e4m3fn_scaled.safetensors\",\r\n   13:         \"type\": \"wan\"\r\n   14:       }\r\n   15:     },\r\n   16:     \"ours\": {\r\n   17:       \"class_type\": \"CLIPLoaderGGUF\",\r\n   18:       \"inputs\": {\r\n   19:         \"clip_name\": \"umt5-xxl-encoder-Q5_K_M.gguf\",\r\n   20:         \"type\": \"wan\"\r\n   21:       }\r\n   22:     }\r\n   23:   },\r\n   24:   \"engine\": \"eng_wan_ti2v\",\r\n   25:   \"fixture\": \"testcard_motion\",\r\n   26:   \"image\": \"lane1_testcard.png\",\r\n   27:   \"lane\": \"lane4_wan_text_encoder\",\r\n   28:   \"prompt\": \"A 1950s broadcast test card filling the frame: colour bars across the top, a grey step wedge, panels of geometric shapes and rows of block letters in decreasing sizes, fine line gratings, and a smooth grey gradient. The camera drifts slowly and steadily to the left across the card at a constant rate, the card itself stays flat, square and rigid, every printed element holding its shape and sharpness as it moves, single continuous shot, no cut, no scene change, nothing warping or rippling.\",\r\n   29:   \"role\": \"authored acuity instrument IN MOTION -- known element sizes, moving\",\r\n   30:   \"wiring_note\": \"encoder feeds ['neg', 'pos'] in BOTH arms; any wiring delta is a staging fault\"\r\n   31: }\r\n===== staging\\lane4_wan_text_encoder\\crowd\\render\\RENDER.json =====\r\n    1: {\r\n    2:   \"arms\": [\r\n    3:     \"ours\",\r\n    4:     \"official\"\r\n    5:   ],\r\n    6:   \"fixture\": \"crowd\",\r\n    7:   \"fps\": 25,\r\n    8:   \"legs\": [\r\n    9:     {\r\n   10:       \"arm\": \"ours\",\r\n   11:       \"elapsed_s\": 230.4,\r\n   12:       \"first_frame\": \"frame_00001_.png\",\r\n   13:       \"fixture\": \"crowd\",\r\n   14:       \"frame_count\": 97,\r\n   15:       \"last_frame\": \"frame_00097_.png\",\r\n   16:       \"leg\": \"crowd/ours_seed42\",\r\n   17:       \"messages\": [\r\n   18:         [\r\n   19:           \"execution_start\",\r\n   20:           {\r\n   21:             \"prompt_id\": \"c5c92339-90c0-4169-b593-dcf22cefd785\",\r\n   22:             \"timestamp\": 1787349461860\r\n   23:           }\r\n   24:         ],\r\n   25:         [\r\n   26:           \"execution_cached\",\r\n   27:           {\r\n   28:             \"nodes\": [],\r\n   29:             \"prompt_id\": \"c5c92339-90c0-4169-b593-dcf22cefd785\",\r\n   30:             \"timestamp\": 1787349462030\r\n   31:           }\r\n   32:         ],\r\n   33:         [\r\n   34:           \"execution_success\",\r\n   35:           {\r\n   36:             \"prompt_id\": \"c5c92339-90c0-4169-b593-dcf22cefd785\",\r\n   37:             \"timestamp\": 1787349683130\r\n   38:           }\r\n   39:         ]\r\n   40:       ],\r\n   41:       \"prompt_id\": \"c5c92339-90c0-4169-b593-dcf22cefd785\",\r\n   42:       \"seed\": 42,\r\n   43:       \"sha256\": \"b055dcab9a41cfb77934568fbfe2eb5b4969451b4327e227bc52cc92d0ffa4f5\",\r\n   44:       \"status\": \"success\",\r\n   45:       \"subfolder\": \"baseline_output\\\\lane4_wan_text_encoder\\\\crowd\\\\ours_seed42\",\r\n   46:       \"temporal\": {\r\n   47:         \"argmax_pair\": 28,\r\n   48:         \"frame_pairs\": 96,\r\n   49:         \"max_abs_delta\": 8.2575,\r\n   50:         \"mean_abs_delta\": 3.204\r\n   51:       }\r\n   52:     },\r\n   53:     {\r\n   54:       \"arm\": \"official\",\r\n   55:       \"elapsed_s\": 210.4,\r\n   56:       \"first_frame\": \"frame_00001_.png\",\r\n   57:       \"fixture\": \"crowd\",\r\n   58:       \"frame_count\": 97,\r\n   59:       \"last_frame\": \"frame_00097_.png\",\r\n   60:       \"leg\": \"crowd/official_seed42\",\r\n   61:       \"messages\": [\r\n   62:         [\r\n   63:           \"execution_start\",\r\n   64:           {\r\n   65:             \"prompt_id\": \"1255f7ce-9db3-4c66-96d9-0b668ad9e4cf\",\r\n   66:             \"timestamp\": 1787349693012\r\n   67:           }\r\n   68:         ],\r\n   69:         [\r\n   70:           \"execution_cached\",\r\n   71:           {\r\n   72:             \"nodes\": [\r\n   73:               \"latent\",\r\n   74:               \"loadimage\",\r\n   75:               \"modelsampling\",\r\n   76:               \"unet\",\r\n   77:               \"vae\"\r\n   78:             ],\r\n   79:             \"prompt_id\": \"1255f7ce-9db3-4c66-96d9-0b668ad9e4cf\",\r\n   80:             \"timestamp\": 1787349693080\r\n   81:           }\r\n   82:         ],\r\n   83:         [\r\n   84:           \"execution_success\",\r\n   85:           {\r\n   86:             \"prompt_id\": \"1255f7ce-9db3-4c66-96d9-0b668ad9e4cf\",\r\n   87:             \"timestamp\": 1787349902369\r\n   88:           }\r\n   89:         ]\r\n   90:       ],\r\n   91:       \"prompt_id\": \"1255f7ce-9db3-4c66-96d9-0b668ad9e4cf\",\r\n   92:       \"seed\": 42,\r\n   93:       \"sha256\": \"70c628ecba4bf77a5dc091577ce7af21c9dca7441d9417c8d1e48c1901203624\",\r\n   94:       \"status\": \"success\",\r\n   95:       \"subfolder\": \"baseline_output\\\\lane4_wan_text_encoder\\\\crowd\\\\official_seed42\",\r\n   96:       \"temporal\": {\r\n   97:         \"argmax_pair\": 28,\r\n   98:         \"frame_pairs\": 96,\r\n   99:         \"max_abs_delta\": 8.1944,\r\n  100:         \"mean_abs_delta\": 3.2353\r\n  101:       }\r\n  102:     }\r\n  103:   ],\r\n  104:   \"output_prefix\": \"baseline_output/lane4_wan_text_encoder\",\r\n  105:   \"seeds\": [\r\n  106:     42,\r\n  107:     20260821\r\n  108:   ],\r\n  109:   \"server\": \"http://127.0.0.1:8000\"\r\n  110: }\r\n===== docs\\2026-08-21-lane4-text-encoder-plan.md =====\r\n    1: # Lane 4 -- wan_ti2v TEXT ENCODER precision, and the purity-gate change it required\r\n    2: \r\n    3: Measurement-only work in the `basline-models` workbench. No OTR production\r\n    4: code, no model download, nothing published to `otr/obs`. Shipped recipes are\r\n    5: untouchable; only a WIN becomes an OTR item, and only through the normal gate.\r\n    6: \r\n    7: ## Why this lane exists\r\n    8: \r\n    9: The 2026-08-21 grounded fleet diff compared the shipping `wan_ti2v` engine\r\n   10: against the official Comfy template `video_wan2_2_5B_ti2v.json` (package\r\n   11: `0.1.50`). Its receipt is\r\n   12: `receipts/2026-08-21-grounded/wan_ti2v__video_wan2_2_5B_ti2v.json`.\r\n   13: \r\n   14: Read literally, that receipt lists **six** parameter differences:\r\n   15: \r\n   16: | # | node.param | reference | ours | status |\r\n   17: | :-- | :-- | :-- | :-- | :-- |\r\n   18: | 1 | `KSampler.cfg` | `5` | `5.0` | serialization noise |\r\n   19: | 2 | `KSampler.denoise` | `1` | `1.0` | serialization noise |\r\n   20: | 3 | `KSampler.seed` | 898471028164125 | 42 | per-render, not a recipe delta |\r\n   21: | 4 | `KSampler.sampler_name` | `uni_pc` | `euler` | SCREENED, lane 1 |\r\n   22: | 5 | `KSampler.steps` | `20` | `30` | SCREENED, lane 1 |\r\n   23: | 6 | `ModelSamplingSD3.shift` | `8` | `5.0` | SCREENED, lane 1, and documented |\r\n   24: \r\n   25: **So there are zero unscreened PARAMETER deltas left on `wan_ti2v`.** What\r\n   26: remains is structural, in `only_in_reference` / `only_in_ours`:\r\n   27: \r\n   28: * `UNETLoader` (`wan2.2_ti2v_5B_fp16.safetensors`) vs `UnetLoaderGGUF`\r\n   29:   (`Wan2.2-TI2V-5B-Q5_K_M.gguf`)\r\n   30: * `CLIPLoader` (`umt5_xxl_fp8_e4m3fn_scaled.safetensors`) vs `CLIPLoaderGGUF`\r\n   31:   (`umt5-xxl-encoder-Q5_K_M.gguf`)\r\n   32: * `VAEDecode` vs `VAEDecodeTiled` (tile 256 / overlap 64 / temporal 16 / 8)\r\n   33: * `CreateVideo` + `SaveVideo` vs our frame saves, and `LoadImage` only in ours\r\n   34:   (harness and t2v-vs-ti2v mode, not quality deltas)\r\n   35: \r\n   36: Lanes 1-3 all screened knobs where somebody had made a deliberate QUALITY\r\n   37: choice, and all three returned NO WIN. **These structural deltas are a\r\n   38: different category: they are COMPROMISES taken for a 16 GB ceiling, and their\r\n   39: cost has never been measured.** That makes them the highest-probability source\r\n   40: of a real quality gap between the shipped graphs and the official template.\r\n   41: \r\n   42: The operator's stated stake is not his own box: he intends the engine to be\r\n   43: read, copied and re-used by other people, some of whom have far more VRAM. A\r\n   44: graph quantized for a 16 GB laptop, shipped as the only graph, does those users\r\n   45: a disservice whether or not it is optimal here.\r\n   46: \r\n   47: **Scope of THIS lane:** the text encoder only. On disk we already have BOTH\r\n   48: files -- `umt5_xxl_fp8_e4m3fn_scaled.safetensors` (6.7 GB, the exact file the\r\n   49: template names) and `umt5-xxl-encoder-Q5_K_M.gguf` (4.1 GB, ours), under\r\n   50: `C:\\ComfyUI-Models\\text_encoders\\`. **No download is required or authorized.**\r\n   51: The fp16 UNET (`wan2.2_ti2v_5B_fp16.safetensors`) is NOT on disk, so the UNET\r\n   52: precision lane remains download-gated and is out of scope.\r\n   53: \r\n   54: ## The contrast\r\n   55: \r\n   56: ONE node, `clip`, swapped class and file:\r\n   57: \r\n   58: ```\r\n   59: ours      CLIPLoaderGGUF   umt5-xxl-encoder-Q5_K_M.gguf            4.1 GB\r\n   60: official  CLIPLoader       umt5_xxl_fp8_e4m3fn_scaled.safetensors  6.7 GB\r\n   61: ```\r\n   62: \r\n   63: Both arms are generated FROM THE SHIPPING ENGINE via\r\n   64: `diffomatic.build_api_graph(\"eng_wan_ti2v\")`, so weights, sampler, tiling,\r\n   65: canvas (832x480), length (97) and topology are identical by construction rather\r\n   66: than by careful copying. The encoder feeds `pos` and `neg` in both arms and the\r\n   67: wiring is untouched.\r\n   68: \r\n   69: ## The purity-gate change this forced, and why it is the risky part\r\n   70: \r\n   71: `tools/purity_gate.py` flattens both graphs structurally and records\r\n   72: `{node}.__class__` as a `CLASS` leaf. Before this change, **any** class\r\n   73: difference was an unconditional abort, consulted against nothing -- deliberately,\r\n   74: because an undeclared class change is exactly the uncontrolled second variable\r\n   75: Bible `12.121` was promoted for.\r\n   76: \r\n   77: A loader lane cannot run under that rule. The change adds an **opt-in,\r\n   78: node-specific** declaration:\r\n   79: \r\n   80: ```\r\n   81: --expect-class NODE=ClassName      e.g.  --expect-class clip=CLIPLoader\r\n   82: ```\r\n   83: \r\n   84: Design intent, stated so it can be attacked:\r\n   85: \r\n   86: 1. The strict default is unchanged -- an UNdeclared class change still aborts.\r\n   87: 2. The permission is per-node and per-target-class; a swap to a different class\r\n   88:    than declared still aborts.\r\n   89: 3. Wiring/topology differences still abort unconditionally, ahead of any class\r\n   90:    handling.\r\n   91: 4. A declared swap that did not actually occur aborts (no phantom declarations).\r\n   92: 5. Leaf-level deltas are still checked separately: the swap does not license\r\n   93:    the new node's inputs to differ freely.\r\n   94: \r\n   95: Regression evidence already run (all five behaved as specified):\r\n   96: \r\n   97: | Test | Expected | Result |\r\n   98: | :-- | :-- | :-- |\r\n   99: | Lane 3's existing declaration, unchanged | PASS | PASS, 1 knob |\r\n  100: | Lane 4 arms, swap NOT declared | FAIL | FAIL |\r\n  101: | Lane 4 arms, swap declared correctly | PASS | PASS, 2 changed leaves |\r\n  102: | Lane 4 arms, WRONG class declared | FAIL | FAIL |\r\n  103: | Swap declared that never happened | FAIL | FAIL |\r\n  104: \r\n  105: On the staged pair the gate reports 43 leaves per side, exactly 2 changed:\r\n  106: `clip.__class__` and `clip.clip_name`, both declared.\r\n  107: \r\n  108: ## Fixtures, and why these two\r\n  109: \r\n  110: A text encoder drives PROMPT ADHERENCE more than it drives fine spatial detail,\r\n  111: which mostly comes from the conditioning image, the UNET and the VAE. So both\r\n  112: fixtures carry countable prompt demands, and one MOVES:\r\n  113: \r\n  114: * **`crowd`** (`lane1_crowd.png`) -- hard content. Dozens of faces, glass tubes,\r\n  115:   a meter scale with ticks; the prompt names what must be present.\r\n  116: * **`testcard_motion`** (`lane1_testcard.png`) -- the authored acuity card as\r\n  117:   the conditioning still, with a prompt DEMANDING a slow constant lateral\r\n  118:   camera drift. Lane 1 proved a card held still is countable; lane 2's\r\n  119:   completeness critic proved a motion claim cannot come from a stillness\r\n  120:   prompt. This fixture is both at once: known element sizes, in motion.\r\n  121: \r\n  122: `wan_ti2v` is image-to-video, so unlike lane 3's pure t2v the card can be\r\n  123: injected as a real ground-truth input rather than prompted into existence.\r\n  124: \r\n  125: 2 fixtures x 2 arms x 2 seeds (42, 20260821) = 8 legs, sequential, one server.\r\n  126: \r\n  127: ## Verdict matrix, declared BEFORE judging\r\n  128: \r\n  129: * **structural_regression** -- an arm with materially more structural defects\r\n  130:   loses regardless of sharpness.\r\n  131: * **adherence_gain** -- the encoder's own axis: does an arm deliver MORE of\r\n  132:   what the prompt names (countable objects, held geometry), counted per arm\r\n  133:   against the PROMPT.\r\n  134: * **null_at_shipping_output** -- LOSS for the candidate; the shipped GGUF\r\n  135:   encoder stands and its VRAM saving is free.\r\n  136: * **candidate_win** -- official WINS -> refutation panel, and then it becomes a\r\n  137:   **QUALITY TIER** proposal for boxes with headroom, never a silent swap of the\r\n  138:   16 GB default.\r\n  139: \r\n  140: That last cell is the point of the lane. A win here does not mean \"change the\r\n  141: shipped graph\"; it means \"the shipped graph is a 16 GB tier and the project\r\n  142: should say so and offer the other one.\"\r\n  143: \r\n  144: ## Known open method debts carried in from lane 3's completeness critic\r\n  145: \r\n  146: These are verified against the files and are NOT fixed by this lane:\r\n  147: \r\n  148: 1. `seat1_full` and `seat2_full` are byte-identical image sets; the panel is 12\r\n  149:    distinct views, not 18. Those duplicate pairs disagreed in 3 of 6 cells --\r\n  150:    the judge noise floor.\r\n  151: 2. Read-order permutation is an independent coin per seat with no balance\r\n  152:    constraint; lane 3 landed 14 candidate-first vs 4 ours-first.\r\n  153: 3. `PANEL_META.json` / `PANEL_PROMPTS.js` were not archived for lane 3, so its\r\n  154:    judge model and questions are unrecorded.\r\n  155: 4. Arm-to-arm NCC is computed nowhere in the harness, though lane 1 made it an\r\n  156:    admission rule (~0.90 at the final frame).\r\n  157: 5. Seats see 3 of 97 frames; rendered PAIR clips exist and are never judged.\r\n  158: \r\n  159: ## What this plan is asking the panel\r\n  160: \r\n  161: 1. Is the `--expect-class` extension actually as narrow as claimed, or does it\r\n  162:    open a path for a second uncontrolled difference to ride along?\r\n  163: 2. Is a text-encoder swap judgeable AT ALL on these two fixtures, or is the\r\n  164:    instrument mismatched to the knob (the honest worry: encoder precision may\r\n  165:    be invisible on an image-conditioned lane where the still dominates)?\r\n  166: 3. Does `testcard_motion` measure acuity-under-motion, or does prompted camera\r\n  167:    drift simply destroy the card and floor both arms (a 12.121 floor effect)?\r\n  168: 4. What in the harness would make a WIN here unshippable or unsafe to act on?\r\n  169: 5. Which of the five carried-in method debts must be fixed BEFORE this lane's\r\n  170:    panel runs, rather than after?\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$files = @('\"'tools\\\\purity_gate.py','staging\\\\lane4_wan_text_encoder\\\\build_arms.py','staging\\\\lane4_wan_text_encoder\\\\render_arms.py','tools\\\\make_judge_set.py','tools\\\\temporal_stats.py'); foreach (\"'$f in $files) { \"===== $f =====\"; $i=0; Get-Content -LiteralPath $f | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ } }'","aggregated_output":"    1: \"\"\"Prove two staged A/B arms differ by EXACTLY the knobs the lane declared.\r\n    2: \r\n    3: Bible 12.121: an uncontrolled second variable sends every arm of a visual A/B\r\n    4: to the same wrong verdict, and single-variable discipline is routinely applied\r\n    5: to the graph delta while the shared inputs drift. This is the mechanical half\r\n    6: of that rule -- verify arm purity with a deterministic diff, not a model pass.\r\n    7: \r\n    8: It is deliberately structural rather than textual: a text diff cannot tell a\r\n    9: reordered key from a changed one, and cannot tell a changed literal from a\r\n   10: rewired link. Any wiring difference is a topology change and fails the gate\r\n   11: outright, whatever the lane declared.\r\n   12: \r\n   13: Usage:\r\n   14:     python purity_gate.py <arm_a.json> <arm_b.json> --contrast <STAGING.json>\r\n   15:     python purity_gate.py a.json b.json --expect node.input=value [...]\r\n   16: \r\n   17: Exit 0 = pure; the lane may render. Exit 1 = ABORT THE LANE.\r\n   18: \"\"\"\r\n   19: from __future__ import annotations\r\n   20: \r\n   21: import argparse\r\n   22: import hashlib\r\n   23: import io\r\n   24: import json\r\n   25: import sys\r\n   26: from pathlib import Path\r\n   27: \r\n   28: \r\n   29: def _is_wire(value) -> bool:\r\n   30:     \"\"\"A ComfyUI API link: ``[node_id, output_slot]``.\"\"\"\r\n   31:     return (\r\n   32:         isinstance(value, list)\r\n   33:         and len(value) == 2\r\n   34:         and isinstance(value[0], str)\r\n   35:         and isinstance(value[1], int)\r\n   36:         and not isinstance(value[1], bool)\r\n   37:     )\r\n   38: \r\n   39: \r\n   40: def _walk(value, path: str, out: dict) -> None:\r\n   41:     \"\"\"Flatten one input into ``{dotted path: leaf}``, wires kept whole.\"\"\"\r\n   42:     if _is_wire(value):\r\n   43:         out[path] = (\"WIRE\", f\"{value[0]}:{value[1]}\")\r\n   44:         return\r\n   45:     if isinstance(value, dict):\r\n   46:         if not value:\r\n   47:             out[path] = (\"LITERAL\", \"{}\")\r\n   48:             return\r\n   49:         for key in sorted(value):\r\n   50:             _walk(value[key], f\"{path}.{key}\", out)\r\n   51:         return\r\n   52:     if isinstance(value, list):\r\n   53:         if not value:\r\n   54:             out[path] = (\"LITERAL\", \"[]\")\r\n   55:             return\r\n   56:         for index, item in enumerate(value):\r\n   57:             _walk(item, f\"{path}[{index}]\", out)\r\n   58:         return\r\n   59:     out[path] = (\"LITERAL\", value)\r\n   60: \r\n   61: \r\n   62: def flatten(graph: dict) -> dict:\r\n   63:     flat = {}\r\n   64:     for node_id in sorted(graph):\r\n   65:         node = graph[node_id]\r\n   66:         flat[f\"{node_id}.__class__\"] = (\"CLASS\", node.get(\"class_type\"))\r\n   67:         for key in sorted(node.get(\"inputs\") or {}):\r\n   68:             _walk(node[\"inputs\"][key], f\"{node_id}.{key}\", flat)\r\n   69:     return flat\r\n   70: \r\n   71: \r\n   72: def load(path: Path) -> dict:\r\n   73:     graph = json.loads(io.open(path, encoding=\"utf-8\").read())\r\n   74:     if not isinstance(graph, dict) or not graph:\r\n   75:         raise SystemExit(f\"[FAIL] {path.name}: not a non-empty API graph\")\r\n   76:     for node_id, node in graph.items():\r\n   77:         if not isinstance(node, dict) or \"class_type\" not in node:\r\n   78:             raise SystemExit(f\"[FAIL] {path.name}: node {node_id!r} is not API-shaped\")\r\n   79:     return graph\r\n   80: \r\n   81: \r\n   82: def verify_manifest(manifest: Path, arms: dict[str, Path]) -> tuple[list[str], list[str]]:\r\n   83:     \"\"\"Confirm the staged bytes still hash to what staging recorded.\r\n   84: \r\n   85:     Returns ``(log lines, failures)``.  The failures are returned rather than\r\n   86:     merely printed because an arm whose bytes no longer match its manifest is\r\n   87:     the exact fault the downstream receipts assume was checked -- printing it\r\n   88:     while passing the gate would be worse than not checking at all.\r\n   89:     \"\"\"\r\n   90:     lines, failures = [], []\r\n   91:     if not manifest.exists():\r\n   92:         return ([f\"[FAIL] no {manifest.name}; arm identity is unproven\"],\r\n   93:                 [f\"[FAIL] no {manifest.name}; arm identity is unproven\"])\r\n   94:     recorded = {}\r\n   95:     for line in io.open(manifest, encoding=\"utf-8\").read().splitlines():\r\n   96:         if line.strip():\r\n   97:             digest, name = line.split(None, 1)\r\n   98:             recorded[name.strip()] = digest\r\n   99:     for path in arms.values():\r\n  100:         actual = hashlib.sha256(path.read_bytes()).hexdigest()\r\n  101:         expected = recorded.get(path.name)\r\n  102:         if expected is None:\r\n  103:             failures.append(f\"[FAIL] {path.name} is absent from {manifest.name}\")\r\n  104:         elif expected != actual:\r\n  105:             failures.append(\r\n  106:                 f\"[FAIL] {path.name} sha256 {actual[:16]} != recorded {expected[:16]}\")\r\n  107:         else:\r\n  108:             lines.append(f\"[OK]   {path.name} sha256 {actual[:16]} matches {manifest.name}\")\r\n  109:     return lines, failures\r\n  110: \r\n  111: \r\n  112: def main(argv=None) -> int:\r\n  113:     parser = argparse.ArgumentParser(description=__doc__)\r\n  114:     parser.add_argument(\"arm_a\")\r\n  115:     parser.add_argument(\"arm_b\")\r\n  116:     parser.add_argument(\"--contrast\", help=\"STAGING.json carrying declared_contrast\")\r\n  117:     parser.add_argument(\"--expect\", action=\"append\", default=[],\r\n  118:                         help=\"declared delta as path=json_value\")\r\n  119:     parser.add_argument(\"--expect-class\", action=\"append\", default=[],\r\n  120:                         dest=\"expect_class\", metavar=\"NODE=ClassName\",\r\n  121:                         help=\"declared NODE CLASS swap at exactly one node, e.g. \"\r\n  122:                              \"clip=CLIPLoader. Every OTHER class change still \"\r\n  123:                              \"fails, and wiring changes still fail unconditionally.\")\r\n  124:     args = parser.parse_args(argv)\r\n  125: \r\n  126:     path_a, path_b = Path(args.arm_a).resolve(), Path(args.arm_b).resolve()\r\n  127:     graph_a, graph_b = load(path_a), load(path_b)\r\n  128: \r\n  129:     declared: dict = {}\r\n  130:     if args.contrast:\r\n  131:         receipt = json.loads(io.open(args.contrast, encoding=\"utf-8\").read())\r\n  132:         declared = dict(receipt.get(\"declared_contrast\") or {})\r\n  133:     for item in args.expect:\r\n  134:         key, _, raw = item.partition(\"=\")\r\n  135:         declared[key] = json.loads(raw)\r\n  136: \r\n  137:     # A declared CLASS swap is the contrast on a loader/precision lane. It stays\r\n  138:     # OPT-IN and node-specific: the default remains \"any class change aborts the\r\n  139:     # lane\", because an UNdeclared class change is exactly the uncontrolled\r\n  140:     # second variable Bible 12.121 was promoted for.\r\n  141:     declared_classes: dict = {}\r\n  142:     for item in args.expect_class:\r\n  143:         node, _, class_name = item.partition(\"=\")\r\n  144:         if not node or not class_name:\r\n  145:             raise SystemExit(\"[FAIL] --expect-class wants NODE=ClassName, got %r\" % item)\r\n  146:         declared_classes[f\"{node}.__class__\"] = class_name\r\n  147:     if not declared and not declared_classes:\r\n  148:         raise SystemExit(\"[FAIL] no declared contrast set; refusing to pass a lane blind\")\r\n  149: \r\n  150:     print(f\"[ARM A] {path_a}\")\r\n  151:     print(f\"[ARM B] {path_b}\")\r\n  152:     manifest_lines, manifest_failures = verify_manifest(\r\n  153:         path_a.parent / \"ARMS.sha256\", {\"a\": path_a, \"b\": path_b})\r\n  154:     for line in manifest_lines:\r\n  155:         print(line)\r\n  156: \r\n  157:     flat_a, flat_b = flatten(graph_a), flatten(graph_b)\r\n  158:     only_a = sorted(set(flat_a) - set(flat_b))\r\n  159:     only_b = sorted(set(flat_b) - set(flat_a))\r\n  160:     changed = sorted(k for k in set(flat_a) & set(flat_b) if flat_a[k] != flat_b[k])\r\n  161: \r\n  162:     failures = list(manifest_failures)\r\n  163:     for key in only_a:\r\n  164:         failures.append(f\"[FAIL] present only in A: {key} = {flat_a[key][1]!r}\")\r\n  165:     for key in only_b:\r\n  166:         failures.append(f\"[FAIL] present only in B: {key} = {flat_b[key][1]!r}\")\r\n  167: \r\n  168:     for key in changed:\r\n  169:         kind_a, value_a = flat_a[key]\r\n  170:         kind_b, value_b = flat_b[key]\r\n  171:         if kind_a == \"WIRE\" or kind_b == \"WIRE\":\r\n  172:             failures.append(f\"[FAIL] TOPOLOGY differs at {key}: {value_a!r} -> {value_b!r}\")\r\n  173:         elif kind_a == \"CLASS\" or kind_b == \"CLASS\":\r\n  174:             if declared_classes.get(key) == value_b:\r\n  175:                 print(f\"[OK]   declared CLASS swap {key}: {value_a!r} -> {value_b!r}\")\r\n  176:             else:\r\n  177:                 failures.append(\r\n  178:                     f\"[FAIL] NODE CLASS differs at {key}: {value_a!r} -> {value_b!r}\")\r\n  179:         elif key not in declared:\r\n  180:             failures.append(f\"[FAIL] UNDECLARED delta at {key}: {value_a!r} -> {value_b!r}\")\r\n  181:         elif value_b != declared[key]:\r\n  182:             failures.append(\r\n  183:                 f\"[FAIL] {key} moved to {value_b!r}, but the lane declared {declared[key]!r}\")\r\n  184:         else:\r\n  185:             print(f\"[OK]   declared delta {key}: {value_a!r} -> {value_b!r}\")\r\n  186: \r\n  187:     for key in sorted(set(declared) - set(changed)):\r\n  188:         failures.append(f\"[FAIL] declared delta {key} did not change between the arms\")\r\n  189:     for key in sorted(set(declared_classes) - set(changed)):\r\n  190:         failures.append(f\"[FAIL] declared CLASS swap {key} did not change between the arms\")\r\n  191: \r\n  192:     print(f\"[COUNT] nodes A={len(graph_a)} B={len(graph_b)} | \"\r\n  193:           f\"leaves A={len(flat_a)} B={len(flat_b)} | changed={len(changed)}\")\r\n  194: \r\n  195:     if failures:\r\n  196:         print()\r\n  197:         for line in failures:\r\n  198:             print(line)\r\n  199:         print(f\"\\n[PURITY GATE] FAILED -- {len(failures)} fault(s). ABORT THE LANE.\")\r\n  200:         return 1\r\n  201:     swaps = (f\" plus the declared CLASS swap(s) {sorted(declared_classes)}\"\r\n  202:              if declared_classes else \"\")\r\n  203:     print(f\"\\n[PURITY GATE] PASSED -- changed-parameter set is EXACTLY \"\r\n  204:           f\"{sorted(declared)} ({len(declared)} knob(s)){swaps}; \"\r\n  205:           f\"everything else is identical.\")\r\n  206:     return 0\r\n  207: \r\n  208: \r\n  209: if __name__ == \"__main__\":\r\n  210:     sys.exit(main())\r\n===== staging\\lane4_wan_text_encoder\\build_arms.py =====\r\n    1: \"\"\"Stage lane 4: wan_ti2v TEXT ENCODER precision -- ours (Q5_K_M GGUF) vs official (fp8-scaled).\r\n    2: \r\n    3: Both arms are generated FROM THE SHIPPING ENGINE (``eng_wan_ti2v``) via\r\n    4: ``diffomatic.build_api_graph``, so weights, sampler, tiling, canvas, length and\r\n    5: topology are identical by construction. The contrast is ONE node: the text\r\n    6: encoder loader.\r\n    7: \r\n    8:   ours      CLIPLoaderGGUF   umt5-xxl-encoder-Q5_K_M.gguf           4.1 GB\r\n    9:   official  CLIPLoader       umt5_xxl_fp8_e4m3fn_scaled.safetensors 6.7 GB\r\n   10: \r\n   11: WHY THIS LANE EXISTS AND WHY IT IS DIFFERENT FROM LANES 1-3. Lanes 1-3 screened\r\n   12: knobs where somebody had made a deliberate QUALITY choice. This delta is not\r\n   13: that: the GGUF encoder is a COMPROMISE taken for a 16 GB ceiling, and nobody has\r\n   14: ever measured what it costs. That makes it the highest-probability source of a\r\n   15: real quality gap between the shipped graphs and the official template -- the\r\n   16: exact exposure for an engine meant to be read, copied and re-used by people who\r\n   17: may have far more VRAM than this box.\r\n   18: \r\n   19: A CLASS SWAP, NOT A LITERAL. The declared contrast is the loader node itself.\r\n   20: Wiring is untouched: both loaders emit CLIP into the same ``pos``/``neg``\r\n   21: encoders, so any wiring difference at all is a staging fault and the purity gate\r\n   22: must still fail it.\r\n   23: \r\n   24: FIXTURES. A text encoder drives PROMPT ADHERENCE, so both fixtures carry\r\n   25: countable prompt demands, and one of them MOVES:\r\n   26: \r\n   27:   crowd            hard content -- dozens of faces, glass tubes, a meter scale\r\n   28:                    with ticks; the prompt names what must be there.\r\n   29:   testcard_motion  the authored acuity card as the conditioning still, with a\r\n   30:                    prompt that DEMANDS a slow lateral move. Lane 1 proved a card\r\n   31:                    held still is countable; lane 2's critic proved a motion\r\n   32:                    claim cannot come from a stillness prompt. This fixture is\r\n   33:                    both at once -- known element sizes, in motion.\r\n   34: \"\"\"\r\n   35: from __future__ import annotations\r\n   36: \r\n   37: import copy\r\n   38: import hashlib\r\n   39: import io\r\n   40: import json\r\n   41: import sys\r\n   42: from pathlib import Path\r\n   43: \r\n   44: HERE = Path(__file__).resolve().parent\r\n   45: sys.path.insert(0, str(HERE.parents[1] / \"tools\"))\r\n   46: import diffomatic  # noqa: E402\r\n   47: \r\n   48: ENGINE = \"eng_wan_ti2v\"\r\n   49: LANE = \"lane4_wan_text_encoder\"\r\n   50: \r\n   51: OFFICIAL_CLIP = {\r\n   52:     \"class_type\": \"CLIPLoader\",\r\n   53:     \"inputs\": {\"clip_name\": \"umt5_xxl_fp8_e4m3fn_scaled.safetensors\", \"type\": \"wan\"},\r\n   54: }\r\n   55: \r\n   56: STEADY_TAIL = (\"static locked-off camera, single continuous shot, no cut, \"\r\n   57:                \"no scene change, no camera move.\")\r\n   58: \r\n   59: FIXTURES = {\r\n   60:     \"crowd\": {\r\n   61:         \"image\": \"lane1_crowd.png\",\r\n   62:         \"role\": \"hard content, countable prompt demands (faces, tubes, meter ticks)\",\r\n   63:         \"prompt\": (\r\n   64:             \"A crowded 1950s tent hall at night, dozens of people shoulder to \"\r\n   65:             \"shoulder watching a large wooden valve radio with a chrome antenna \"\r\n   66:             \"and glowing vacuum tubes on a table in the foreground, warm lantern \"\r\n   67:             \"light overhead, a lit doorway beyond the crowd, only subtle \"\r\n   68:             \"breathing, small head turns in the crowd and a faint flicker in the \"\r\n   69:             \"tube filaments, \" + STEADY_TAIL),\r\n   70:     },\r\n   71:     \"testcard_motion\": {\r\n   72:         \"image\": \"lane1_testcard.png\",\r\n   73:         \"role\": \"authored acuity instrument IN MOTION -- known element sizes, moving\",\r\n   74:         \"prompt\": (\r\n   75:             \"A 1950s broadcast test card filling the frame: colour bars across \"\r\n   76:             \"the top, a grey step wedge, panels of geometric shapes and rows of \"\r\n   77:             \"block letters in decreasing sizes, fine line gratings, and a smooth \"\r\n   78:             \"grey gradient. The camera drifts slowly and steadily to the left \"\r\n   79:             \"across the card at a constant rate, the card itself stays flat, \"\r\n   80:             \"square and rigid, every printed element holding its shape and \"\r\n   81:             \"sharpness as it moves, single continuous shot, no cut, no scene \"\r\n   82:             \"change, nothing warping or rippling.\"),\r\n   83:     },\r\n   84: }\r\n   85: \r\n   86: \r\n   87: def sole(api, class_type):\r\n   88:     \"\"\"The one node of a class -- ambiguity is a staging fault, not a default.\"\"\"\r\n   89:     hits = sorted(k for k, v in api.items() if v[\"class_type\"] == class_type)\r\n   90:     if len(hits) != 1:\r\n   91:         raise SystemExit(\"[FAIL] expected exactly one %s, found %s\" % (class_type, hits))\r\n   92:     return hits[0]\r\n   93: \r\n   94: \r\n   95: def main() -> int:\r\n   96:     base, provenance = diffomatic.build_api_graph(ENGINE)\r\n   97:     clip = sole(base, \"CLIPLoaderGGUF\")\r\n   98:     loadimage = sole(base, \"LoadImage\")\r\n   99:     ksampler = sole(base, \"KSampler\")\r\n  100:     ours_clip = copy.deepcopy(base[clip])\r\n  101: \r\n  102:     if ours_clip[\"inputs\"].get(\"clip_name\") == OFFICIAL_CLIP[\"inputs\"][\"clip_name\"]:\r\n  103:         raise SystemExit(\"[FAIL] the shipping engine already loads the official \"\r\n  104:                          \"encoder; this lane is not a contrast\")\r\n  105: \r\n  106:     # Every consumer of the encoder must survive the swap untouched.\r\n  107:     consumers = sorted(k for k, v in base.items()\r\n  108:                        if any(isinstance(x, list) and len(x) == 2 and x[0] == clip\r\n  109:                               for x in v[\"inputs\"].values()))\r\n  110:     print(\"[WIRING] encoder %r feeds %s -- unchanged in both arms\" % (clip, consumers))\r\n  111: \r\n  112:     all_hashes = {}\r\n  113:     for key in sorted(FIXTURES):\r\n  114:         spec = FIXTURES[key]\r\n  115:         out_dir = HERE / key\r\n  116:         out_dir.mkdir(exist_ok=True)\r\n  117: \r\n  118:         prepared = copy.deepcopy(base)\r\n  119:         prepared[loadimage][\"inputs\"][\"image\"] = spec[\"image\"]\r\n  120:         positive = prepared[ksampler][\"inputs\"][\"positive\"][0]\r\n  121:         prepared[positive][\"inputs\"][\"text\"] = spec[\"prompt\"]\r\n  122: \r\n  123:         written = {}\r\n  124:         for arm in (\"ours\", \"official\"):\r\n  125:             graph = copy.deepcopy(prepared)\r\n  126:             if arm == \"official\":\r\n  127:                 graph[clip] = {\"class_type\": OFFICIAL_CLIP[\"class_type\"],\r\n  128:                                \"inputs\": dict(OFFICIAL_CLIP[\"inputs\"])}\r\n  129:             text = json.dumps(graph, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\"\r\n  130:             path = out_dir / (\"arm_%s.json\" % arm)\r\n  131:             io.open(path, \"w\", encoding=\"utf-8\", newline=\"\\n\").write(text)\r\n  132:             written[arm] = hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\r\n  133:             print(\"[STAGED] %-16s %-18s sha256=%s nodes=%d\"\r\n  134:                   % (key, path.name, written[arm][:16], len(graph)))\r\n  135: \r\n  136:         io.open(out_dir / \"ARMS.sha256\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  137:             \"\".join(\"%s  arm_%s.json\\n\" % (written[a], a) for a in (\"ours\", \"official\")))\r\n  138:         io.open(out_dir / \"STAGING.json\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  139:             json.dumps({\r\n  140:                 \"lane\": LANE,\r\n  141:                 \"fixture\": key,\r\n  142:                 \"engine\": ENGINE,\r\n  143:                 \"image\": spec[\"image\"],\r\n  144:                 \"role\": spec[\"role\"],\r\n  145:                 \"prompt\": spec[\"prompt\"],\r\n  146:                 \"declared_contrast\": {\r\n  147:                     \"kind\": \"node class swap\",\r\n  148:                     \"node\": clip,\r\n  149:                     \"ours\": {\"class_type\": ours_clip[\"class_type\"],\r\n  150:                              \"inputs\": ours_clip[\"inputs\"]},\r\n  151:                     \"official\": OFFICIAL_CLIP,\r\n  152:                 },\r\n  153:                 \"wiring_note\": (\"encoder feeds %s in BOTH arms; any wiring delta \"\r\n  154:                                 \"is a staging fault\" % consumers),\r\n  155:                 \"arm_sha256\": written,\r\n  156:             }, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\")\r\n  157:         all_hashes[key] = written\r\n  158: \r\n  159:     io.open(HERE / \"LANE.json\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  160:         json.dumps({\r\n  161:             \"lane\": LANE,\r\n  162:             \"engine\": ENGINE,\r\n  163:             \"arm_sha256\": all_hashes,\r\n  164:             \"declared_contrast\": {\"node\": clip, \"kind\": \"node class swap\",\r\n  165:                                   \"ours_class\": ours_clip[\"class_type\"],\r\n  166:                                   \"official_class\": OFFICIAL_CLIP[\"class_type\"]},\r\n  167:             \"fixtures\": {k: {\"output_subdir\": k, \"role\": FIXTURES[k][\"role\"]}\r\n  168:                          for k in FIXTURES},\r\n  169:             \"provenance\": provenance,\r\n  170:             \"verdict_matrix\": {\r\n  171:                 \"structural_regression\": (\"an arm with materially more structural \"\r\n  172:                     \"defects loses regardless of sharpness\"),\r\n  173:                 \"adherence_gain\": (\"the encoder's own axis: does an arm deliver \"\r\n  174:                     \"MORE of what the prompt names (countable objects, held \"\r\n  175:                     \"geometry) -- counted per arm against the PROMPT\"),\r\n  176:                 \"null_at_shipping_output\": (\"LOSS for the candidate; the shipped \"\r\n  177:                     \"GGUF encoder stands and the VRAM saving is free\"),\r\n  178:                 \"candidate_win\": (\"official WINS -> refutation panel, then this \"\r\n  179:                     \"becomes a QUALITY TIER proposal for boxes with headroom, \"\r\n  180:                     \"never a silent swap on a 16 GB default\"),\r\n  181:             },\r\n  182:         }, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\")\r\n  183:     print(\"[LANE] %s staged: %d fixtures x 2 arms\" % (LANE, len(FIXTURES)))\r\n  184:     return 0\r\n  185: \r\n  186: \r\n  187: if __name__ == \"__main__\":\r\n  188:     raise SystemExit(main())\r\n===== staging\\lane4_wan_text_encoder\\render_arms.py =====\r\n    1: \"\"\"Render lane 4: every fixture, two arms, two seeds, sequentially, one server.\r\n    2: \r\n    3: Same receipts discipline as lanes 1-3: live ``/object_info`` preflight for\r\n    4: every class and model filename (INCLUDING both encoder loaders, since the two\r\n    5: arms load different classes), purity re-proved on the graphs actually queued,\r\n    6: outputs read back from ``/history``, temporal stats per leg. Best effort per\r\n    7: the no-VRAM-ceremony ruling -- the fp8 encoder is ~2.6 GB larger than the GGUF\r\n    8: one, so an OOM on the official arm is a plain recorded fault, not a project.\r\n    9: \r\n   10: Seed node is ``KSampler.seed``; the terminal is ``vaedecode`` and a\r\n   11: ``SaveImage`` is appended identically to both arms (native 832x480 frames).\r\n   12: \r\n   13: THE CONTRAST IS A NODE CLASS SWAP, so the submit gate declares it explicitly\r\n   14: via ``--expect-class``. Every OTHER class change, and any wiring change at all,\r\n   15: still aborts the lane.\r\n   16: \r\n   17: usage: render_arms.py [fixture_key ...]      (default: every staged fixture)\r\n   18: \"\"\"\r\n   19: from __future__ import annotations\r\n   20: \r\n   21: import hashlib\r\n   22: import io\r\n   23: import json\r\n   24: import sys\r\n   25: import time\r\n   26: import urllib.error\r\n   27: import urllib.request\r\n   28: from pathlib import Path\r\n   29: \r\n   30: HERE = Path(__file__).resolve().parent\r\n   31: sys.path.insert(0, str(HERE.parents[1] / \"tools\"))\r\n   32: import purity_gate  # noqa: E402\r\n   33: import temporal_stats  # noqa: E402\r\n   34: \r\n   35: SERVER = \"http://127.0.0.1:8000\"\r\n   36: SEEDS = [42, 20260821]\r\n   37: ARMS = [\"ours\", \"official\"]\r\n   38: OUT_PREFIX = \"baseline_output/lane4_wan_text_encoder\"\r\n   39: LEG_TIMEOUT_S = 2 * 60 * 60\r\n   40: # class -> file-carrying inputs to confirm against the live enum options.\r\n   41: # BOTH encoder loaders are listed: the arms load different classes, and a lane\r\n   42: # whose candidate file is missing must fail at preflight, not at submit.\r\n   43: MODEL_INPUTS = {\r\n   44:     \"UnetLoaderGGUF\": [\"unet_name\"],\r\n   45:     \"CLIPLoaderGGUF\": [\"clip_name\"],\r\n   46:     \"CLIPLoader\": [\"clip_name\"],\r\n   47:     \"VAELoader\": [\"vae_name\"],\r\n   48:     \"LoadImage\": [\"image\"],\r\n   49: }\r\n   50: \r\n   51: \r\n   52: def get_json(url, timeout=90):\r\n   53:     with urllib.request.urlopen(url, timeout=timeout) as response:\r\n   54:         return json.loads(response.read().decode(\"utf-8\"))\r\n   55: \r\n   56: \r\n   57: def post_json(url, payload, timeout=60):\r\n   58:     data = json.dumps(payload).encode(\"utf-8\")\r\n   59:     request = urllib.request.Request(\r\n   60:         url, data=data, headers={\"Content-Type\": \"application/json\"})\r\n   61:     with urllib.request.urlopen(request, timeout=timeout) as response:\r\n   62:         return json.loads(response.read().decode(\"utf-8\"))\r\n   63: \r\n   64: \r\n   65: def enum_options(spec):\r\n   66:     \"\"\"Selectable values of a combo input, legacy or V3 shape.\r\n   67: \r\n   68:     Legacy: ``[[opt, ...], {...}]``. V3: ``[\"COMBO\", {\"options\": [opt, ...]}]``\r\n   69:     -- LatentUpscaleModelLoader ships the V3 shape and the legacy-only reader\r\n   70:     called its installed model missing (lane 2 preflight, 2026-08-21).\r\n   71:     \"\"\"\r\n   72:     if isinstance(spec, list) and spec:\r\n   73:         if isinstance(spec[0], list):\r\n   74:             return list(spec[0])\r\n   75:         if spec[0] == \"COMBO\" and len(spec) > 1 and isinstance(spec[1], dict):\r\n   76:             return list(spec[1].get(\"options\") or [])\r\n   77:     return []\r\n   78: \r\n   79: \r\n   80: def preflight(graphs, object_info):\r\n   81:     faults = []\r\n   82:     seen = set()\r\n   83:     for graph in graphs.values():\r\n   84:         for node_id, node in graph.items():\r\n   85:             class_type = node[\"class_type\"]\r\n   86:             if class_type not in object_info:\r\n   87:                 faults.append(\r\n   88:                     \"class %r (node %r) absent from /object_info\" % (class_type, node_id))\r\n   89:                 continue\r\n   90:             seen.add(class_type)\r\n   91:             for input_name in MODEL_INPUTS.get(class_type, []):\r\n   92:                 wanted = node[\"inputs\"].get(input_name)\r\n   93:                 spec = ((object_info[class_type].get(\"input\") or {}).get(\"required\") or {})\r\n   94:                 options = enum_options(spec.get(input_name))\r\n   95:                 if not options:\r\n   96:                     faults.append(\"%s.%s exposes no selectable values\"\r\n   97:                                   % (class_type, input_name))\r\n   98:                 elif wanted not in options:\r\n   99:                     faults.append(\"%s.%s=%r is not installed (server offers %d)\"\r\n  100:                                   % (class_type, input_name, wanted, len(options)))\r\n  101:     for class_type in sorted(seen):\r\n  102:         print(\"[OBJECT_INFO] %s: present\" % class_type)\r\n  103:     return faults\r\n  104: \r\n  105: \r\n  106: def leg_prefix(fixture, arm, seed):\r\n  107:     return \"%s/%s/%s_seed%d/frame\" % (OUT_PREFIX, fixture, arm, seed)\r\n  108: \r\n  109: \r\n  110: def build_submission(fixture, arm, seed):\r\n  111:     graph = json.loads(io.open(HERE / fixture / (\"arm_%s.json\" % arm),\r\n  112:                                encoding=\"utf-8\").read())\r\n  113:     graph[\"ksampler\"][\"inputs\"][\"seed\"] = seed\r\n  114:     graph[\"save\"] = {\r\n  115:         \"class_type\": \"SaveImage\",\r\n  116:         \"inputs\": {\"images\": [\"vaedecode\", 0],\r\n  117:                    \"filename_prefix\": leg_prefix(fixture, arm, seed)},\r\n  118:     }\r\n  119:     return graph\r\n  120: \r\n  121: \r\n  122: def gate_submissions(fixture, seed, submitted, receipts, manifest):\r\n  123:     paths = {}\r\n  124:     for arm, graph in submitted.items():\r\n  125:         path = receipts / (\"submitted_%s_seed%d.json\" % (arm, seed))\r\n  126:         text = json.dumps(graph, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\"\r\n  127:         io.open(path, \"w\", encoding=\"utf-8\", newline=\"\\n\").write(text)\r\n  128:         manifest[path.name] = hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\r\n  129:         paths[arm] = path\r\n  130:     io.open(receipts / \"ARMS.sha256\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  131:         \"\".join(\"%s  %s\\n\" % (manifest[n], n) for n in sorted(manifest)))\r\n  132:     declared = [\r\n  133:         'clip.clip_name=\"umt5_xxl_fp8_e4m3fn_scaled.safetensors\"',\r\n  134:         'save.filename_prefix=\"%s\"' % leg_prefix(fixture, \"official\", seed),\r\n  135:     ]\r\n  136:     argv = [str(paths[\"ours\"]), str(paths[\"official\"])]\r\n  137:     for item in declared:\r\n  138:         argv += [\"--expect\", item]\r\n  139:     argv += [\"--expect-class\", \"clip=CLIPLoader\"]\r\n  140:     print(\"[SUBMIT GATE] %s seed %d\" % (fixture, seed))\r\n  141:     return purity_gate.main(argv) == 0\r\n  142: \r\n  143: \r\n  144: def wait_for_leg(prompt_id, started):\r\n  145:     while True:\r\n  146:         if time.time() - started > LEG_TIMEOUT_S:\r\n  147:             return {\"status\": \"TIMEOUT\", \"outputs\": {}, \"messages\": []}\r\n  148:         try:\r\n  149:             history = get_json(\"%s/history/%s\" % (SERVER, prompt_id))\r\n  150:         except (urllib.error.URLError, TimeoutError) as exc:\r\n  151:             return {\"status\": \"SERVER GONE: %s\" % exc, \"outputs\": {}, \"messages\": []}\r\n  152:         except json.JSONDecodeError:\r\n  153:             # A restarting server can answer with an HTML error page; that is\r\n  154:             # a hiccup to ride out, not a reason to abandon the queued legs.\r\n  155:             time.sleep(10)\r\n  156:             continue\r\n  157:         entry = history.get(prompt_id)\r\n  158:         if entry:\r\n  159:             status = entry.get(\"status\") or {}\r\n  160:             if status.get(\"completed\") or status.get(\"status_str\") in (\"success\", \"error\"):\r\n  161:                 return {\"status\": status.get(\"status_str\", \"unknown\"),\r\n  162:                         \"outputs\": entry.get(\"outputs\") or {},\r\n  163:                         \"messages\": status.get(\"messages\") or []}\r\n  164:         time.sleep(10)\r\n  165: \r\n  166: \r\n  167: def main():\r\n  168:     lane = json.loads(io.open(HERE / \"LANE.json\", encoding=\"utf-8\").read())\r\n  169:     wanted = sys.argv[1:] or sorted(lane[\"fixtures\"])\r\n  170:     unknown = [k for k in wanted if k not in lane[\"fixtures\"]]\r\n  171:     if unknown:\r\n  172:         print(\"[FAIL] unknown fixture(s): %s\" % unknown)\r\n  173:         return 1\r\n  174: \r\n  175:     print(\"[SERVER] %s\" % SERVER)\r\n  176:     print(\"[FIXTURES] %s\" % \", \".join(wanted))\r\n  177:     object_info = get_json(\"%s/object_info\" % SERVER, timeout=300)\r\n  178:     print(\"[OBJECT_INFO] %d classes registered\" % len(object_info))\r\n  179: \r\n  180:     # The sigmas ADAPT depends on ManualSigmas accepting a string: confirm the\r\n  181:     # contract on THIS server before anything queues.\r\n  182:     manual = object_info.get(\"ManualSigmas\")\r\n  183:     if not manual:\r\n  184:         print(\"[FAIL] ManualSigmas absent from /object_info; the ADAPT is void\")\r\n  185:         return 1\r\n  186:     sig_spec = ((manual.get(\"input\") or {}).get(\"required\") or {}).get(\"sigmas\")\r\n  187:     print(\"[ADAPT CHECK] ManualSigmas.sigmas spec head: %s\"\r\n  188:           % json.dumps(sig_spec)[:120])\r\n  189: \r\n  190:     plan = {}\r\n  191:     for fixture in wanted:\r\n  192:         for seed in SEEDS:\r\n  193:             for arm in ARMS:\r\n  194:                 plan[(fixture, arm, seed)] = build_submission(fixture, arm, seed)\r\n  195: \r\n  196:     named = {\"%s_%s_%d\" % k: g for k, g in plan.items()}\r\n  197:     faults = preflight(named, object_info)\r\n  198:     if faults:\r\n  199:         for fault in sorted(set(faults)):\r\n  200:             print(\"[FAIL] %s\" % fault)\r\n  201:         print(\"[PREFLIGHT] FAILED -- nothing queued.\")\r\n  202:         return 1\r\n  203:     print(\"[PREFLIGHT] PASSED -- every class and model filename is live on this server.\")\r\n  204: \r\n  205:     for fixture in wanted:\r\n  206:         receipts = HERE / fixture / \"render\"\r\n  207:         receipts.mkdir(parents=True, exist_ok=True)\r\n  208:         manifest = {}\r\n  209:         for seed in SEEDS:\r\n  210:             arms_for_seed = {arm: plan[(fixture, arm, seed)] for arm in ARMS}\r\n  211:             if not gate_submissions(fixture, seed, arms_for_seed, receipts, manifest):\r\n  212:                 print(\"[FAIL] %s seed %d is not pure. Nothing queued.\" % (fixture, seed))\r\n  213:                 return 1\r\n  214: \r\n  215:     legs = []\r\n  216:     for fixture in wanted:\r\n  217:         receipts = HERE / fixture / \"render\"\r\n  218:         fixture_legs = []\r\n  219:         for seed in SEEDS:\r\n  220:             for arm in ARMS:\r\n  221:                 graph = plan[(fixture, arm, seed)]\r\n  222:                 text = json.dumps(graph, indent=2, sort_keys=True,\r\n  223:                                   ensure_ascii=False) + \"\\n\"\r\n  224:                 digest = hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\r\n  225:                 label = \"%s/%s_seed%d\" % (fixture, arm, seed)\r\n  226:                 print(\"\")\r\n  227:                 print(\"[LEG] %s  sha256=%s  encoder=%s seed=%s\"\r\n  228:                       % (label, digest[:16],\r\n  229:                          graph[\"clip\"][\"inputs\"][\"clip_name\"],\r\n  230:                          graph[\"ksampler\"][\"inputs\"][\"seed\"]))\r\n  231:                 started = time.time()\r\n  232:                 try:\r\n  233:                     queued = post_json(\"%s/prompt\" % SERVER, {\"prompt\": graph})\r\n  234:                 except urllib.error.HTTPError as exc:\r\n  235:                     detail = exc.read().decode(\"utf-8\", \"replace\")[:2000]\r\n  236:                     print(\"[FAULT] %s: submit rejected: %s\" % (label, detail))\r\n  237:                     fixture_legs.append({\"leg\": label, \"fixture\": fixture,\r\n  238:                                          \"arm\": arm, \"seed\": seed,\r\n  239:                                          \"sha256\": digest, \"status\": \"REJECTED\",\r\n  240:                                          \"detail\": detail})\r\n  241:                     legs.append(fixture_legs[-1])\r\n  242:                     continue\r\n  243:                 prompt_id = queued.get(\"prompt_id\")\r\n  244:                 print(\"[QUEUED] %s prompt_id=%s\" % (label, prompt_id))\r\n  245:                 result = wait_for_leg(prompt_id, started)\r\n  246:                 elapsed = round(time.time() - started, 1)\r\n  247:                 images = []\r\n  248:                 for output in (result[\"outputs\"] or {}).values():\r\n  249:                     images.extend(output.get(\"images\") or [])\r\n  250:                 print(\"[DONE] %s status=%s frames=%d elapsed=%ss\"\r\n  251:                       % (label, result[\"status\"], len(images), elapsed))\r\n  252:                 if result[\"status\"] != \"success\":\r\n  253:                     print(\"[FAULT] %s: %s\"\r\n  254:                           % (label, json.dumps(result.get(\"messages\"))[:1500]))\r\n  255:                 record = {\r\n  256:                     \"leg\": label, \"fixture\": fixture, \"arm\": arm, \"seed\": seed,\r\n  257:                     \"sha256\": digest, \"prompt_id\": prompt_id,\r\n  258:                     \"status\": result[\"status\"], \"elapsed_s\": elapsed,\r\n  259:                     \"frame_count\": len(images),\r\n  260:                     \"subfolder\": images[0][\"subfolder\"] if images else None,\r\n  261:                     \"first_frame\": images[0][\"filename\"] if images else None,   18: cell after cell and look like corroboration.   19: \r\n   20: The arm behind every label lives in KEY.json, which is the driver's file and is\r\n   21: never handed to a seat.\r\n   22: \r\n   23: Crops are cut, never resampled: a judge asked \"which eye-chart row still reads\"\r\n   24: must be looking at the model's own pixels, not at an interpolation of them.\r\n   25: Crop regions are per fixture, aimed at whatever that fixture makes countable.\r\n   26: \r\n   27: usage: make_judge_set.py <lane_dir> <fixture> <seed> <judge_out_root>\r\n   28: \"\"\"\r\n   29: from __future__ import annotations\r\n   30: \r\n   31: import hashlib\r\n   32: import io\r\n   33: import json\r\n   34: import shutil\r\n   35: import sys\r\n   36: from pathlib import Path\r\n   37: \r\n   38: from PIL import Image\r\n   39: \r\n   40: COMFY_OUTPUT = Path(r\"C:\\Users\\jeffr\\Documents\\ComfyUI\\output\")\r\n   41: FRAMES = [1, 49, 97]\r\n   42: CROP_FRAMES = [49, 97]\r\n   43: \r\n   44: # Per lane and fixture, the regions that carry the countable evidence.\r\n   45: # lane2_ltx25 renders at 1664x960 -- exactly double the 832x480 authoring\r\n   46: # canvas -- so its boxes are the lane 1 coordinates x2, identity regions first.\r\n   47: REGIONS = {\r\n   48:     \"lane1_wan_ti2v\": {\r\n   49:         \"officer\": [(\"face\", 216, 16, 320, 320), (\"uniform\", 60, 340, 256, 128)],\r\n   50:         \"controlroom\": [(\"dials\", 512, 176, 320, 160), (\"figure\", 320, 140, 208, 232)],\r\n   51:         \"crowd\": [(\"meter\", 330, 404, 260, 76), (\"faces\", 500, 60, 224, 168)],\r\n   52:         \"testcard\": [(\"eye_light\", 8, 258, 400, 160), (\"eye_dark\", 424, 258, 400, 160),\r\n   53:                      (\"gratings_light\", 8, 208, 400, 46),\r\n   54:                      (\"gratings_dark\", 424, 208, 400, 46)],\r\n   55:     },\r\n   56:     \"lane3_ltx_video\": {\r\n   57:         # 1024x576 t2v. march is a MOVING subject: fixed boxes are judged with\r\n   58:         # per-frame count questions only, never cross-frame tracking.\r\n   59:         \"portrait\": [(\"face\", 300, 20, 420, 380), (\"mic\", 380, 330, 320, 240)],\r\n   60:         \"march\": [(\"players\", 30, 170, 700, 360), (\"street_right\", 700, 160, 320, 380)],\r\n   61:         \"radio\": [(\"tubes\", 280, 80, 480, 260), (\"dial_grille\", 210, 320, 640, 220)],\r\n   62:     },\r\n   63:     \"lane2_ltx25\": {\r\n   64:         \"officer\": [(\"face\", 432, 32, 640, 640), (\"uniform\", 120, 680, 512, 256)],\r\n   65:         \"crowd\": [(\"faces\", 1000, 120, 448, 336), (\"meter\", 660, 808, 520, 152)],\r\n   66:         \"testcard\": [(\"eye_light\", 16, 516, 800, 320), (\"eye_dark\", 848, 516, 800, 320),\r\n   67:                      (\"gratings_light\", 16, 416, 800, 92),\r\n   68:                      (\"gratings_dark\", 848, 416, 800, 92)],\r\n   69:     },\r\n   70: }\r\n   71: SEAT_LABELS = {\r\n   72:     \"seat1_full\": (\"A\", \"B\"),\r\n   73:     \"seat2_full\": (\"X\", \"Y\"),\r\n   74:     \"seat3_crops\": (\"P\", \"Q\"),\r\n   75: }\r\n   76: \r\n   77: \r\n   78: def seat_plan(fixture: str, seed: int, lane_name: str = \"\") -> dict:\r\n   79:     \"\"\"Assign each seat a read order, varied per cell rather than fixed.\r\n   80: \r\n   81:     Two arms admit only two orders, so one order is always used twice. The\r\n   82:     digest decides which seat is the odd one out and which arm leads, so the\r\n   83:     repeat does not land on the same seats in every cell.\r\n   84:     \"\"\"\r\n   85:     # The digest covers lane, fixture, seed AND seat index. The first version\r\n   86:     # hashed only (fixture, seed): over lane 2's six cells that yielded 3\r\n   87:     # distinct maps and left seat1 reading the candidate first in 5 of 6 --\r\n   88:     # a near-constant position dressed as a permutation (completeness critic,\r\n   89:     # 2026-08-21). Per-seat bytes make the variation real.\r\n   90:     lane = str(lane_name)\r\n   91:     plan = {}\r\n   92:     for index, (seat, (first, second)) in enumerate(sorted(SEAT_LABELS.items())):\r\n   93:         digest = hashlib.sha256((\"%s|%s|%d|%d\" % (lane, fixture, seed, index))\r\n   94:                                 .encode(\"utf-8\")).digest()\r\n   95:         leads = bool(digest[0] & 1)\r\n   96:         ours_label, candidate_label = (first, second) if leads else (second, first)\r\n   97:         plan[seat] = {\"ours\": ours_label, \"candidate\": candidate_label,\r\n   98:                       \"order\": [first, second],\r\n   99:                       \"reads_first\": \"ours\" if leads else \"candidate\"}\r\n  100:     return plan\r\n  101: \r\n  102: \r\n  103: def main(argv=None) -> int:\r\n  104:     argv = list(sys.argv[1:] if argv is None else argv)\r\n  105:     if len(argv) != 4:\r\n  106:         print(__doc__)\r\n  107:         return 2\r\n  108:     lane_dir, fixture, seed, out_root = Path(argv[0]), argv[1], int(argv[2]), Path(argv[3])\r\n  109: \r\n  110:     lane = json.loads(io.open(lane_dir / \"LANE.json\", encoding=\"utf-8\").read())\r\n  111:     if fixture not in lane[\"fixtures\"]:\r\n  112:         print(\"[FAIL] unknown fixture %r\" % fixture)\r\n  113:         return 1\r\n  114:     lane_name = lane[\"lane\"]\r\n  115:     if lane_name not in REGIONS or fixture not in REGIONS[lane_name]:\r\n  116:         print(\"[FAIL] no crop regions declared for %s/%s\" % (lane_name, fixture))\r\n  117:         return 1\r\n  118:     arms = sorted(lane[\"arm_sha256\"][fixture])\r\n  119:     if len(arms) != 2 or \"ours\" not in arms:\r\n  120:         print(\"[FAIL] expected exactly two arms including 'ours', got %s\" % arms)\r\n  121:         return 1\r\n  122:     candidate = next(a for a in arms if a != \"ours\")\r\n  123:     subdir = lane[\"fixtures\"][fixture][\"output_subdir\"]\r\n  124:     base = COMFY_OUTPUT / \"baseline_output\" / lane_name\r\n  125:     if subdir:\r\n  126:         base = base / subdir\r\n  127: \r\n  128:     out_dir = out_root / fixture / (\"seed%d\" % seed)\r\n  129:     if out_dir.exists():\r\n  130:         shutil.rmtree(out_dir)\r\n  131:     out_dir.mkdir(parents=True)\r\n  132: \r\n  133:     legs = {arm: \"%s_seed%d\" % (arm, seed) for arm in (\"ours\", candidate)}\r\n  134:     for arm, leg in legs.items():\r\n  135:         for index in sorted(set(FRAMES + CROP_FRAMES)):\r\n  136:             path = base / leg / (\"frame_%05d_.png\" % index)\r\n  137:             if not path.exists():\r\n  138:                 print(\"[FAIL] missing %s\" % path)\r\n  139:                 return 1\r\n  140: \r\n  141:     regions = REGIONS[lane_name][fixture]\r\n  142:     key = {\"fixture\": fixture, \"seed\": seed, \"legs\": legs, \"seats\": {}, \"files\": {}}\r\n  143:     manifest = {\"fixture\": fixture, \"seed\": seed, \"seats\": {}}\r\n  144: \r\n  145:     for seat, spec in seat_plan(fixture, seed, lane_name).items():\r\n  146:         seat_dir = out_dir / seat\r\n  147:         seat_dir.mkdir()\r\n  148:         shown = []\r\n  149:         crops_only = seat.startswith(\"seat3\")\r\n  150:         for arm, leg in legs.items():\r\n  151:             label = spec[\"ours\"] if arm == \"ours\" else spec[\"candidate\"]\r\n  152:             if crops_only:\r\n  153:                 for index in CROP_FRAMES:\r\n  154:                     with Image.open(base / leg / (\"frame_%05d_.png\" % index)) as image:\r\n  155:                         for name, left, top, width, height in regions:\r\n  156:                             box = (left, top, left + width, top + height)\r\n  157:                             if box[2] > image.width or box[3] > image.height:\r\n  158:                                 print(\"[FAIL] crop %s exceeds canvas %s\"\r\n  159:                                       % (name, image.size))\r\n  160:                                 return 1\r\n  161:                             filename = \"%s_f%03d_%s.png\" % (label, index, name)\r\n  162:                             image.crop(box).save(seat_dir / filename)\r\n  163:                             shown.append(filename)\r\n  164:                             key[\"files\"][filename] = {\r\n  165:                                 \"arm\": arm, \"leg\": leg, \"frame\": index,\r\n  166:                                 \"region\": name, \"box\": list(box)}\r\n  167:             else:\r\n  168:                 for index in FRAMES:\r\n  169:                     filename = \"%s_f%03d.png\" % (label, index)\r\n  170:                     shutil.copyfile(base / leg / (\"frame_%05d_.png\" % index),\r\n  171:                                     seat_dir / filename)\r\n  172:                     shown.append(filename)\r\n  173:                     key[\"files\"][filename] = {\"arm\": arm, \"leg\": leg, \"frame\": index}\r\n  174:         key[\"seats\"][seat] = {\"ours\": spec[\"ours\"], candidate: spec[\"candidate\"],\r\n  175:                               \"reads_first\": spec[\"reads_first\"]}\r\n  176:         manifest[\"seats\"][seat] = {\r\n  177:             \"dir\": str(seat_dir), \"read_order\": spec[\"order\"],\r\n  178:             \"files\": sorted(shown),\r\n  179:             \"kind\": \"native-pixel crops\" if crops_only else \"full matched frames\",\r\n  180:         }\r\n  181:         print(\"[SEAT] %-22s %-12s %2d image(s)  order=%s\"\r\n  182:               % (seat, fixture, len(shown), \"->\".join(spec[\"order\"])))\r\n  183: \r\n  184:     io.open(out_dir / \"KEY.json\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  185:         json.dumps(key, indent=2, sort_keys=True) + \"\\n\")\r\n  186:     io.open(out_dir / \"MANIFEST.json\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  187:         json.dumps(manifest, indent=2, sort_keys=True) + \"\\n\")\r\n  188:     print(\"[JUDGE SET] %s\" % out_dir)\r\n  189:     return 0\r\n  190: \r\n  191: \r\n  192: if __name__ == \"__main__\":\r\n  193:     sys.exit(main())\r\n===== tools\\temporal_stats.py =====\r\n    1: \"\"\"Per-leg temporal stability: mean and max |frame(t) - frame(t-1)| luminance.\r\n    2: \r\n    3: Lane 1 closed having never measured the axis a sampling recipe moves most --\r\n    4: the clips existed, nobody cited them, and when the completeness critic finally\r\n    5: measured it the official arm was worse in 7 of 8 cells. This makes the number a\r\n    6: standard receipt field so no future lane can skip it: one numpy pass over\r\n    7: frames already on disk, no re-render.\r\n    8: \r\n    9: Import surface: ``leg_stats(frames_dir)`` returns the dict render harnesses\r\n   10: embed per leg. CLI surface: point it at RENDER.json files to backfill legs that\r\n   11: predate the field.\r\n   12: \r\n   13: usage: temporal_stats.py <RENDER.json> [...]\r\n   14: \"\"\"\r\n   15: from __future__ import annotations\r\n   16: \r\n   17: import io\r\n   18: import json\r\n   19: import sys\r\n   20: from pathlib import Path\r\n   21: \r\n   22: import numpy as np\r\n   23: from PIL import Image\r\n   24: \r\n   25: COMFY_OUTPUT = Path(r\"C:\\Users\\jeffr\\Documents\\ComfyUI\\output\")\r\n   26: \r\n   27: \r\n   28: def leg_stats(frames_dir: Path) -> dict:\r\n   29:     \"\"\"Mean/max absolute frame-to-frame luminance delta over every frame pair.\"\"\"\r\n   30:     frames = sorted(frames_dir.glob(\"frame_*_.png\"))\r\n   31:     if len(frames) < 2:\r\n   32:         return {\"error\": \"fewer than 2 frames in %s\" % frames_dir}\r\n   33:     previous = None\r\n   34:     deltas = []\r\n   35:     for path in frames:\r\n   36:         current = np.asarray(Image.open(path).convert(\"L\"), dtype=np.float32)\r\n   37:         if previous is not None:\r\n   38:             deltas.append(float(np.abs(current - previous).mean()))\r\n   39:         previous = current\r\n   40:     return {\r\n   41:         \"frame_pairs\": len(deltas),\r\n   42:         \"mean_abs_delta\": round(float(np.mean(deltas)), 4),\r\n   43:         \"max_abs_delta\": round(float(np.max(deltas)), 4),\r\n   44:         \"argmax_pair\": int(np.argmax(deltas)) + 1,\r\n   45:     }\r\n   46: \r\n   47: \r\n   48: def backfill(render_json: Path) -> int:\r\n   49:     doc = json.loads(io.open(render_json, encoding=\"utf-8\").read())\r\n   50:     changed = 0\r\n   51:     for leg in doc.get(\"legs\", []):\r\n   52:         if leg.get(\"status\") != \"success\" or \"temporal\" in leg:\r\n   53:             continue\r\n   54:         subfolder = leg.get(\"subfolder\")\r\n   55:         if not subfolder:\r\n   56:             continue\r\n   57:         frames_dir = COMFY_OUTPUT / subfolder\r\n   58:         if not frames_dir.is_dir():\r\n   59:             print(\"[SKIP] %s: no dir %s\" % (leg[\"leg\"], frames_dir))\r\n   60:             continue\r\n   61:         leg[\"temporal\"] = leg_stats(frames_dir)\r\n   62:         changed += 1\r\n   63:         print(\"[TEMPORAL] %-34s mean=%.3f max=%.3f (pair %d)\"\r\n   64:               % (leg[\"leg\"], leg[\"temporal\"][\"mean_abs_delta\"],\r\n   65:                  leg[\"temporal\"][\"max_abs_delta\"], leg[\"temporal\"][\"argmax_pair\"]))\r\n   66:     if changed:\r\n   67:         io.open(render_json, \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n   68:             json.dumps(doc, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\")\r\n   69:         print(\"[WROTE] %s (%d leg(s))\" % (render_json, changed))\r\n   70:     return changed\r\n   71: \r\n   72: \r\n   73: def main(argv) -> int:\r\n   74:     if not argv:\r\n   75:         print(__doc__)\r\n   76:         return 2\r\n   77:     total = 0\r\n   78:     for arg in argv:\r\n   79:         total += backfill(Path(arg).resolve())\r\n   80:     print(\"[DONE] %d leg(s) backfilled\" % total)\r\n   81:     return 0\r\n   82: \r\n   83: \r\n   84: if __name__ == \"__main__\":\r\n   85:     sys.exit(main(sys.argv[1:]))\r\n","exit_code":0,"status":"completed"}}
