{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'tools\\\\make_clips.py'; \\\"===== \"'$f =====\"; if(-not(Test-Path -LiteralPath $f)){ \"MISSING\"; exit 0 }; $lines=Get-Content -LiteralPath $f; for($i=1; ($i -le 320) -and ($i -le $lines.Count); $i++){ '\"'{0,5}: {1}' -f \"'$i,$lines[$i-1] }'","aggregated_output":"    1: \"\"\"Encode each rendered leg to an mp4, and one side-by-side pair per fixture.\r\n    2: \r\n    3: The judging is done on the PNG frames, which are lossless. These clips exist so\r\n    4: a human can watch the result move -- a still cannot show temporal flicker, and\r\n    5: flicker is the thing a sampling recipe is most likely to change on a video lane.\r\n    6: \r\n    7: The paired clips are labelled LEFT and RIGHT rather than by arm, so the eye\r\n    8: gets a look before the label does. The mapping is written to CLIPS.json.\r\n    9: \"\"\"\r\n   10: from __future__ import annotations\r\n   11: \r\n   12: import io\r\n   13: import json\r\n   14: import subprocess\r\n   15: import sys\r\n   16: from pathlib import Path\r\n   17: \r\n   18: COMFY_OUTPUT = Path(r\"C:\\Users\\jeffr\\Documents\\ComfyUI\\output\")\r\n   19: BASE = COMFY_OUTPUT / \"baseline_output\" / \"lane1_wan_ti2v\"\r\n   20: FPS = 25\r\n   21: # LEFT/RIGHT is fixed per fixture but alternates across fixtures, so a viewer\r\n   22: # cannot settle into \"the left one is always ours\".\r\n   23: LEFT_ARM = {\"officer\": \"ours\", \"controlroom\": \"official\",\r\n   24:             \"crowd\": \"ours\", \"testcard\": \"official\"}\r\n   25: \r\n   26: \r\n   27: def run(args):\r\n   28:     result = subprocess.run(args, capture_output=True, text=True)\r\n   29:     if result.returncode != 0:\r\n   30:         print(\"[FFMPEG FAIL] %s\" % result.stderr.strip().splitlines()[-1:])\r\n   31:     return result.returncode == 0\r\n   32: \r\n   33: \r\n   34: def encode_leg(frames_dir: Path, destination: Path) -> bool:\r\n   35:     return run([\"ffmpeg\", \"-y\", \"-loglevel\", \"error\", \"-framerate\", str(FPS),\r\n   36:                 \"-i\", str(frames_dir / \"frame_%05d_.png\"),\r\n   37:                 \"-c:v\", \"libx264\", \"-crf\", \"16\", \"-preset\", \"medium\",\r\n   38:                 \"-pix_fmt\", \"yuv420p\", str(destination)])\r\n   39: \r\n   40: \r\n   41: def encode_pair(left: Path, right: Path, destination: Path) -> bool:\r\n   42:     label = (\"[0:v]drawtext=text='LEFT':x=12:y=12:fontsize=22:fontcolor=white:\"\r\n   43:              \"box=1:boxcolor=black@0.6:boxborderw=6[l];\"\r\n   44:              \"[1:v]drawtext=text='RIGHT':x=12:y=12:fontsize=22:fontcolor=white:\"\r\n   45:              \"box=1:boxcolor=black@0.6:boxborderw=6[r];[l][r]hstack=inputs=2\")\r\n   46:     return run([\"ffmpeg\", \"-y\", \"-loglevel\", \"error\",\r\n   47:                 \"-framerate\", str(FPS), \"-i\", str(left / \"frame_%05d_.png\"),\r\n   48:                 \"-framerate\", str(FPS), \"-i\", str(right / \"frame_%05d_.png\"),\r\n   49:                 \"-filter_complex\", label,\r\n   50:                 \"-c:v\", \"libx264\", \"-crf\", \"16\", \"-preset\", \"medium\",\r\n   51:                 \"-pix_fmt\", \"yuv420p\", str(destination)])\r\n   52: \r\n   53: \r\n   54: def main(argv) -> int:\r\n   55:     lane_dir = Path(argv[0]) if argv else None\r\n   56:     lane = json.loads(io.open(lane_dir / \"LANE.json\", encoding=\"utf-8\").read())\r\n   57:     seeds = [42, 20260821]\r\n   58:     clips_dir = BASE / \"_clips\"\r\n   59:     clips_dir.mkdir(parents=True, exist_ok=True)\r\n   60: \r\n   61:     record = {\"fps\": FPS, \"left_right_mapping\": {}, \"singles\": [], \"pairs\": []}\r\n   62:     for fixture in sorted(lane[\"fixtures\"]):\r\n   63:         subdir = lane[\"fixtures\"][fixture][\"output_subdir\"]\r\n   64:         base = BASE / subdir if subdir else BASE\r\n   65:         left_arm = LEFT_ARM[fixture]\r\n   66:         right_arm = \"official\" if left_arm == \"ours\" else \"ours\"\r\n   67:         record[\"left_right_mapping\"][fixture] = {\"LEFT\": left_arm, \"RIGHT\": right_arm}\r\n   68:         for seed in seeds:\r\n   69:             dirs = {arm: base / (\"%s_seed%d\" % (arm, seed)) for arm in (\"ours\", \"official\")}\r\n   70:             if not all(d.exists() for d in dirs.values()):\r\n   71:                 print(\"[SKIP] %s seed%d: frames missing\" % (fixture, seed))\r\n   72:                 continue\r\n   73:             for arm, frames in dirs.items():\r\n   74:                 single = clips_dir / (\"%s_%s_seed%d.mp4\" % (fixture, arm, seed))\r\n   75:                 if encode_leg(frames, single):\r\n   76:                     record[\"singles\"].append(single.name)\r\n   77:             pair = clips_dir / (\"PAIR_%s_seed%d.mp4\" % (fixture, seed))\r\n   78:             if encode_pair(dirs[left_arm], dirs[right_arm], pair):\r\n   79:                 record[\"pairs\"].append(pair.name)\r\n   80:                 print(\"[PAIR] %-12s seed%-9d LEFT=%-8s RIGHT=%s\"\r\n   81:                       % (fixture, seed, left_arm, right_arm))\r\n   82: \r\n   83:     io.open(clips_dir / \"CLIPS.json\", \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n   84:         json.dumps(record, indent=2, sort_keys=True) + \"\\n\")\r\n   85:     print(\"[CLIPS] %d single(s), %d pair(s) -> %s\"\r\n   86:           % (len(record[\"singles\"]), len(record[\"pairs\"]), clips_dir))\r\n   87:     return 0\r\n   88: \r\n   89: \r\n   90: if __name__ == \"__main__\":\r\n   91:     sys.exit(main(sys.argv[1:]))\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'tools\\\\run_aa_control.py'; \\\"===== \"'$f =====\"; if(-not(Test-Path -LiteralPath $f)){ \"MISSING\"; exit 0 }; $lines=Get-Content -LiteralPath $f; for($i=1; ($i -le 360) -and ($i -le $lines.Count); $i++){ '\"'{0,5}: {1}' -f \"'$i,$lines[$i-1] }'","aggregated_output":"    1: \"\"\"Render one arm TWICE and judge it against itself: the panel's noise floor.\r\n    2: \r\n    3: Every A/B verdict on this programme assumes that when two clips are the same\r\n    4: recipe, the panel says TIE. Nothing had ever tested that. Without it there is\r\n    5: no way to tell a real effect from run-to-run nondeterminism plus rater\r\n    6: variance, which is exactly how lane 1's one \"unanimous, clear\" cell nearly\r\n    7: became a committed win.\r\n    8: \r\n    9: The second run re-submits the BYTE-IDENTICAL graph that already ran, changing\r\n   10: only the output destination. It renders into a NEW directory rather than over\r\n   11: the first: the original frames are cited by sha256 in the lane receipts, and\r\n   12: re-running in place would destroy the record that cites them.\r\n   13: \r\n   14: The correct result is TIE on every seat. Anything else means the instrument is\r\n   15: reading noise, and every margin it has ever reported is suspect.\r\n   16: \r\n   17: usage: run_aa_control.py <submitted_graph.json> <output_prefix>\r\n   18: \"\"\"\r\n   19: from __future__ import annotations\r\n   20: \r\n   21: import hashlib\r\n   22: import io\r\n   23: import json\r\n   24: import sys\r\n   25: import time\r\n   26: import urllib.error\r\n   27: import urllib.request\r\n   28: from pathlib import Path\r\n   29: \r\n   30: SERVER = \"http://127.0.0.1:8000\"\r\n   31: TIMEOUT_S = 60 * 60\r\n   32: \r\n   33: \r\n   34: def get_json(url, timeout=90):\r\n   35:     with urllib.request.urlopen(url, timeout=timeout) as response:\r\n   36:         return json.loads(response.read().decode(\"utf-8\"))\r\n   37: \r\n   38: \r\n   39: def post_json(url, payload, timeout=60):\r\n   40:     data = json.dumps(payload).encode(\"utf-8\")\r\n   41:     request = urllib.request.Request(\r\n   42:         url, data=data, headers={\"Content-Type\": \"application/json\"})\r\n   43:     with urllib.request.urlopen(request, timeout=timeout) as response:\r\n   44:         return json.loads(response.read().decode(\"utf-8\"))\r\n   45: \r\n   46: \r\n   47: def main(argv):\r\n   48:     if len(argv) != 2:\r\n   49:         print(__doc__)\r\n   50:         return 2\r\n   51:     source = Path(argv[0]).resolve()\r\n   52:     prefix = argv[1]\r\n   53: \r\n   54:     original = json.loads(io.open(source, encoding=\"utf-8\").read())\r\n   55:     graph = json.loads(json.dumps(original))\r\n   56:     graph[\"save\"][\"inputs\"][\"filename_prefix\"] = prefix + \"/frame\"\r\n   57: \r\n   58:     changed = [k for k in graph\r\n   59:                if json.dumps(graph[k], sort_keys=True) != json.dumps(original[k], sort_keys=True)]\r\n   60:     if changed != [\"save\"]:\r\n   61:         print(\"[FAIL] rerun differs from the original in %s, not just the \"\r\n   62:               \"destination\" % changed)\r\n   63:         return 1\r\n   64:     for node in graph:\r\n   65:         if node == \"save\":\r\n   66:             continue\r\n   67:         assert graph[node] == original[node]\r\n   68:     print(\"[A/A] re-submitting %s\" % source.name)\r\n   69:     print(\"[A/A] identical in every node except save.filename_prefix\")\r\n   70:     # Lane-agnostic knob echo: name whichever seed/strength literals exist.\r\n   71:     for node_id, input_name in ((\"ksampler\", \"seed\"), (\"ksampler\", \"sampler_name\"),\r\n   72:                                 (\"ksampler\", \"steps\"), (\"modelsampling\", \"shift\"),\r\n   73:                                 (\"noise\", \"noise_seed\"), (\"i2v\", \"strength\"),\r\n   74:                                 (\"refine_i2v\", \"strength\")):\r\n   75:         node = graph.get(node_id)\r\n   76:         if node and input_name in node.get(\"inputs\", {}):\r\n   77:             print(\"[A/A] %s.%s = %s\" % (node_id, input_name,\r\n   78:                                         node[\"inputs\"][input_name]))\r\n   79: \r\n   80:     started = time.time()\r\n   81:     try:\r\n   82:         queued = post_json(\"%s/prompt\" % SERVER, {\"prompt\": graph})\r\n   83:     except urllib.error.HTTPError as exc:\r\n   84:         print(\"[FAIL] submit rejected: %s\" % exc.read().decode(\"utf-8\", \"replace\")[:800])\r\n   85:         return 1\r\n   86:     prompt_id = queued.get(\"prompt_id\")\r\n   87:     print(\"[A/A] queued prompt_id=%s\" % prompt_id)\r\n   88: \r\n   89:     while True:\r\n   90:         if time.time() - started > TIMEOUT_S:\r\n   91:             print(\"[FAIL] timeout\")\r\n   92:             return 1\r\n   93:         entry = get_json(\"%s/history/%s\" % (SERVER, prompt_id)).get(prompt_id)\r\n   94:         if entry:\r\n   95:             status = (entry.get(\"status\") or {})\r\n   96:             if status.get(\"completed\") or status.get(\"status_str\") in (\"success\", \"error\"):\r\n   97:                 break\r\n   98:         time.sleep(5)\r\n   99: \r\n  100:     images = []\r\n  101:     for output in (entry.get(\"outputs\") or {}).values():\r\n  102:         for image in output.get(\"images\") or []:\r\n  103:             images.append(image)\r\n  104:     elapsed = round(time.time() - started, 1)\r\n  105:     print(\"[A/A] status=%s frames=%d elapsed=%ss\"\r\n  106:           % (status.get(\"status_str\"), len(images), elapsed))\r\n  107: \r\n  108:     receipt = {\r\n  109:         \"control\": \"A/A null\",\r\n  110:         \"source_graph\": str(source),\r\n  111:         \"source_sha256\": hashlib.sha256(source.read_bytes()).hexdigest(),\r\n  112:         \"prompt_id\": prompt_id,\r\n  113:         \"status\": status.get(\"status_str\"),\r\n  114:         \"frame_count\": len(images),\r\n  115:         \"elapsed_s\": elapsed,\r\n  116:         \"output_prefix\": prefix,\r\n  117:         \"note\": (\"Same recipe, same seed, same graph -- only the destination \"\r\n  118:                  \"differs. A panel that does not return TIE here is reading \"\r\n  119:                  \"noise.\"),\r\n  120:     }\r\n  121:     destination = source.parent / \"AA_CONTROL.json\"\r\n  122:     io.open(destination, \"w\", encoding=\"utf-8\", newline=\"\\n\").write(\r\n  123:         json.dumps(receipt, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\")\r\n  124:     print(\"[A/A] receipt -> %s\" % destination)\r\n  125:     return 0 if status.get(\"status_str\") == \"success\" else 2\r\n  126: \r\n  127: \r\n  128: if __name__ == \"__main__\":\r\n  129:     sys.exit(main(sys.argv[1:]))\r\n","exit_code":0,"status":"completed"}}
